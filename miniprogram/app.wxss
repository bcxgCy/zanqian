/**app.wxss - 心愿存钱商务财富主题**/
page {
  --color-primary: #165DFF;
  --color-primary-dark: #0E4BD9;
  --color-primary-light: #E8F3FF;
  --color-primary-soft: #F2F6FF;
  --color-gold: #D4AF37;
  --color-success: #00B42A;
  --color-warning: #FF7D00;
  --color-peach: #D4AF37;
  --color-peach-dark: #B78F1F;
  --color-blue: #165DFF;
  --color-page-bg: #F7F8FA;
  --color-card: #FFFFFF;
  --color-card-white: #FFFFFF;
  --color-text: #1D2129;
  --color-text-secondary: #4E5969;
  --color-text-muted: #86909C;
  --color-placeholder: #C9CDD4;
  --color-border: #E5E6EB;
  --color-input-bg: #FFFFFF;
  --color-danger: #F53F3F;
  --color-done-bg: #F0FFF4;
  --color-disabled-bg: #F2F3F5;
  --color-ad-bg: #F2F3F5;
  --progress-bg: #E8F3FF;
  --mask: rgba(0, 0, 0, 0.55);
  --shadow-card: 0 8rpx 24rpx rgba(29, 33, 41, 0.06);
  --shadow-primary: 0 8rpx 20rpx rgba(22, 93, 255, 0.22);
  --radius-card: 16rpx;
  --radius-item: 8rpx;
  --radius-btn: 12rpx;
  --radius-sheet: 20rpx;
  --spacing: 24rpx;

  background: var(--color-page-bg);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Helvetica, sans-serif;
  color: var(--color-text);
  font-size: 26rpx;
  font-weight: 400;
}

button {
  background: initial;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
}

.green {
  color: var(--color-success);
}

.mint {
  color: var(--color-primary);
}

.peach {
  color: var(--color-gold);
}

.blue {
  color: var(--color-primary);
}

.arrow {
  color: var(--color-text-muted);
}

@keyframes progress-flow {
  0% { background-position: 0% 50%; }
  100% { background-position: 200% 50%; }
}

.progress-fill-animated {
  background: linear-gradient(90deg, #165DFF, #0E4BD9, #165DFF, #00B42A);
  background-size: 200% 100%;
  animation: progress-flow 3s ease infinite;
}

@keyframes item-done-bounce {
  0% { transform: translateY(0); }
  40% { transform: translateY(-8rpx); }
  100% { transform: translateY(0); }
}

.period-done-animate {
  animation: item-done-bounce 0.6s ease;
}

@keyframes sheet-slide-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.sheet-show-animate {
  animation: sheet-slide-up 0.3s ease;
}

@keyframes badge-glow {
  0% { box-shadow: 0 0 0 0 rgba(212, 175, 55, 0.45); }
  70% { box-shadow: 0 0 0 12rpx rgba(212, 175, 55, 0); }
  100% { box-shadow: 0 0 0 0 rgba(212, 175, 55, 0); }
}

.badge-glow {
  animation: badge-glow 1.2s ease;
}

.btn-mint {
  background: var(--color-primary) !important;
  color: #fff !important;
  border-radius: var(--radius-btn);
  box-shadow: var(--shadow-primary);
}

.btn-peach {
  background: var(--color-primary) !important;
  color: #fff !important;
  border-radius: var(--radius-btn);
  box-shadow: var(--shadow-primary);
}

.btn-ghost {
  background: transparent !important;
  color: var(--color-text-secondary) !important;
  border-radius: var(--radius-btn);
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-primary);
  z-index: 100;
}

.fab-peach {
  background: var(--color-primary);
}

.fab-icon {
  font-size: 44rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
}

.icon-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.section-title-text {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--color-text);
}

.page-amount {
  font-size: 60rpx;
  font-weight: 600;
  color: var(--color-warning);
}

.module-amount {
  font-size: 40rpx;
  font-weight: 600;
}

.helper-text {
  font-size: 24rpx;
  font-weight: 300;
  color: var(--color-text-secondary);
}
