/* 打卡成功弹窗样式 - 紧凑版 */

/* 遮罩层 */
.success-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0);
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.3s ease;
  visibility: hidden;
  opacity: 0;
}

.success-mask.show {
  background-color: rgba(0, 0, 0, 0.6);
  visibility: visible;
  opacity: 1;
}

/* 内容区 - 弹性缩放动画 */
.success-content {
  width: 88%;
  max-width: 600rpx;
  background: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
  position: relative;
  transform: scale(0.9) translateY(16rpx);
  transition: all 0.25s ease-out;
  visibility: hidden;
  opacity: 0;
}

.success-content.show {
  transform: scale(1) translateY(0);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  visibility: visible;
  opacity: 1;
}

/* 关闭按钮 */
.close-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.close-btn:active {
  background: rgba(0, 0, 0, 0.12);
}

.close-icon {
  font-size: 24rpx;
  color: #86909c;
  line-height: 1;
}

/* 海报容器 - 缩小内边距 */
.poster-container {
  width: 100%;
  padding: 20rpx 24rpx 16rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f0f5ff 0%, #ffffff 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 320rpx; /* 减小最小高度 */
}

/* 海报图片 */
.poster-image {
  width: 100%;
  height: auto;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(22, 93, 255, 0.12);
}

/* 空状态占位 */
.empty-poster {
  width: 100%;
  height: 360rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f7f8fa;
  border-radius: 12rpx;
}

.empty-text {
  font-size: 24rpx;
  color: #86909c;
}

/* 绘制中状态 - 紧凑 */
.drawing-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0;
}

.spinner {
  width: 52rpx;
  height: 52rpx;
  border: 5rpx solid #e5e6eb;
  border-top-color: #165dff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.drawing-text {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #86909c;
}

/* 绘制失败状态 - 紧凑 */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
}

.error-icon {
  font-size: 36rpx;
  margin-bottom: 12rpx;
}

.error-text {
  font-size: 26rpx;
  color: #f53f3f;
  margin-bottom: 16rpx;
  text-align: center;
}

.retry-btn {
  font-size: 24rpx;
  color: #165dff;
  background: transparent;
  padding: 10rpx 28rpx;
  border: 2rpx solid #165dff;
  border-radius: 28rpx;
}

.retry-btn::after {
  border: none;
}

/* 成功信息 - 紧凑 */
.success-info {
  padding: 20rpx 24rpx;
  text-align: center;
}

.success-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1d2129;
  display: block;
  margin-bottom: 4rpx;
}

.success-sub {
  font-size: 24rpx;
  color: #86909c;
  display: block;
}

/* 操作按钮区 - 紧凑 */
.action-buttons {
  padding: 16rpx 24rpx 24rpx;
  display: flex;
  gap: 16rpx;
}

/* 主按钮 - 分享 - 紧凑 */
.share-btn {
  flex: 1;
  height: 76rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #ffffff !important;
  background: linear-gradient(135deg, #165dff 0%, #36bffa 100%) !important;
  border-radius: 38rpx;
  border: none !important;
  margin: 0;
  align-items: center;
  justify-content: center;
  padding: 0;
  display: flex;
}

.share-btn::after {
  border: none;
}

/* 次要按钮 - 保存 - 紧凑 */
.save-btn {
  flex: 1;
  height: 76rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #165dff !important;
  background: rgba(22, 93, 255, 0.08) !important;
  border-radius: 38rpx;
  border: none !important;
  margin: 0;
  align-items: center;
  justify-content: center;
  padding: 0;
  display: flex;
}

.save-btn::after {
  border: none;
}
