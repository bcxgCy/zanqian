.page {
  min-height: 100vh;
  background: #FFF9F0;
  padding-bottom: calc(112rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.content {
  box-sizing: border-box;
  padding: 20rpx var(--spacing) 20rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 40rpx;
  border: 2rpx solid #EEF4E3;
  box-shadow: 0 8rpx 32rpx rgba(168, 216, 78, 0.12), 0 2rpx 8rpx rgba(255, 255, 255, 0.7);
  margin-bottom: 20rpx;
}

.hero {
  padding: 24rpx 26rpx;
  background: linear-gradient(135deg, #FFF1CF 0%, #FFF6DF 50%, #FFF9EB 100%);
  border: 4rpx solid #FFFFFF;
}

.hero-caption {
  display: block;
  font-size: 22rpx;
  color: #8A6A31;
}

.hero-title {
  display: block;
  margin-top: 6rpx;
  font-size: 38rpx;
  font-weight: 800;
  color: #2F2A22;
}

.hero-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #7E776B;
}

.form-card {
  padding: 20rpx;
}

.field {
  margin-bottom: 18rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #2F2A22;
}

.input,
.textarea {
  width: 100%;
  background: #FFF9F0;
  border-radius: 24rpx;
  border: 2rpx solid #E3ECD4;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  color: #2F2A22;
  height: 92rpx;
  line-height: 92rpx;
}

.textarea {
  height: 180rpx;
  min-height: 180rpx;
  max-height: 180rpx;
  line-height: 1.5;
  padding-top: 16rpx;
  padding-bottom: 16rpx;
  overflow-y: auto;
}

.input:focus,
.textarea:focus {
  border-color: #E6B34E;
}

.input-placeholder,
.textarea-placeholder {
  color: #A9A092;
}

.image-list {
  display: flex;
  gap: 12rpx;
}

.image-item,
.image-add {
  width: 132rpx;
  height: 132rpx;
  border-radius: 18rpx;
  overflow: hidden;
  position: relative;
}

.image {
  width: 100%;
  height: 100%;
  display: block;
}

.image-add {
  border: 2rpx dashed #E1D4B8;
  background: #FFF7E8;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-add-plus {
  font-size: 52rpx;
  line-height: 1;
  color: #B7852F;
}

.remove {
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  text-align: center;
  line-height: 34rpx;
  font-size: 24rpx;
}

.mode-row {
  display: flex;
  gap: 12rpx;
}

.mode-item {
  flex: 1;
  text-align: center;
  line-height: 68rpx;
  border-radius: 999rpx;
  border: 2rpx solid #E3ECD4;
  color: #7A746A;
  background: #FFF9F0;
  font-size: 24rpx;
}

.mode-item.active {
  color: #8A5A19;
  border-color: #F0C979;
  background: #FFF2D5;
  font-weight: 700;
}

.switch-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-field .label {
  margin-bottom: 0;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 10rpx 16rpx calc(10rpx + env(safe-area-inset-bottom));
  /* background: transparent; */
  border-top: 0;
}

.submit-btn {
  background: #E6B34E;
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 72rpx;
}

.share-mask {
  position: fixed;
  inset: 0;
  background: rgba(39, 28, 10, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
  z-index: 99;
}

.share-dialog {
  width: 100%;
  background: #FFFDF8;
  border-radius: 28rpx;
  padding: 34rpx 28rpx 26rpx;
  border: 2rpx solid #F2E6D0;
  box-shadow: 0 16rpx 48rpx rgba(148, 98, 18, 0.16);
}

.share-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #3A2B15;
}

.share-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7D6A4B;
}

.share-actions {
  margin-top: 28rpx;
  display: flex;
  gap: 16rpx;
}

.share-action {
  flex: 1;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 72rpx;
  padding: 0;
  margin: 0;
}

.share-action::after {
  border: 0;
}

.share-action.ghost {
  background: #F7F2E7;
  color: #7E673E;
}

.share-action.primary {
  background: #E6B34E;
  color: #fff;
}

.share-close {
  margin-top: 18rpx;
  text-align: center;
  font-size: 24rpx;
  color: #A08E70;
}
