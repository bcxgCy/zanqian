.page {
  min-height: 100vh;
  background: #FFF7F5;
  padding: var(--spacing);
  box-sizing: border-box;
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
}

.card-shell {
  background: #fff;
  border: 2rpx solid #F6E2E6;
  border-radius: 36rpx;
  padding: 18rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 8rpx 28rpx rgba(219, 155, 171, .14);
}

.book-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.book-main {
  flex: 1;
  min-width: 0;
}

.book-name {
  display: block;
  font-size: 29rpx;
  font-weight: 700;
  color: #4A3B42;
}

.book-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9B7F88;
}

.current-tag,
.default-tag {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
}

.current-tag {
  background: #FFEAF0;
  color: #B45F77;
}

.default-tag {
  background: #FFF0F3;
  color: #C1778D;
}

.actions {
  margin-top: 14rpx;
  display: flex;
  gap: 10rpx;
}

.btn {
  flex: 1;
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  background: #FFF2F5;
  border: 2rpx solid #F4D9DF;
  color: #8B5A68;
  font-size: 22rpx;
}

.btn.danger {
  background: #FFE9EE;
  border-color: #FFD7E1;
  color: #C45470;
}

.create-btn {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  text-align: center;
  background: linear-gradient(90deg, #E986A1 0%, #DB7290 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 22rpx rgba(219, 114, 144, .3);
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(70, 43, 52, .34);
  z-index: 120;
}

.modal {
  position: fixed;
  left: 36rpx;
  right: 36rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx;
  z-index: 121;
}

.modal-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #4A3B42;
}

.field {
  margin-top: 14rpx;
}

.label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 23rpx;
  color: #6D5860;
}

.input {
  height: 82rpx;
  border-radius: 16rpx;
  border: 2rpx solid #F4D9DF;
  background: #FFF8FA;
  padding: 0 16rpx;
  font-size: 24rpx;
  color: #4A3B42;
}

.modal-actions {
  margin-top: 18rpx;
  display: flex;
  gap: 10rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: #FFF2F5;
  color: #8B5A68;
}

.modal-btn.primary {
  background: linear-gradient(90deg, #E986A1 0%, #DB7290 100%);
  color: #fff;
}
