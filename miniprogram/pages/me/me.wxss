.page {
  padding: var(--spacing);
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: var(--spacing);
  margin-bottom: var(--spacing);
  box-shadow: var(--shadow-card);
}

.profile-card {
  background: var(--color-card);
}

.profile-top {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing);
}

.avatar-wrap {
  margin-right: 16rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-primary);
}

.avatar-placeholder {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  background: var(--color-card-white);
}

.profile-info {
  flex: 1;
}

.nickname {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text);
}

.edit-tip {
  display: block;
  margin-top: 4rpx;
}

.stats-link-top {
  font-size: 26rpx;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  text-align: center;
  padding-top: var(--spacing);
  border-top: 1rpx solid var(--color-border);
}

.stat-num {
  display: block;
}

.stat-label {
  display: block;
  margin-top: 6rpx;
}

.section-title {
  margin-bottom: 16rpx;
}

.star-deco {
  font-size: 18rpx;
  color: var(--color-primary);
}

.badge-scroll {
  white-space: nowrap;
}

.badge-list {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 0;
}

.badge-item {
  width: 140rpx;
  text-align: center;
  padding: 16rpx 12rpx;
  border-radius: var(--radius-item);
  flex-shrink: 0;
}

.badge-item.unlocked {
  background: rgba(212, 175, 55, 0.12);
  border: 1rpx solid var(--color-gold);
}

.badge-item.locked {
  background: var(--color-page-bg);
  opacity: 0.55;
}

.badge-icon {
  display: block;
  font-size: 40rpx;
}

.badge-name {
  display: block;
  font-size: 22rpx;
  color: var(--color-text);
  margin-top: 8rpx;
}

.badge-desc {
  display: block;
  font-size: 20rpx;
  margin-top: 4rpx;
  line-height: 1.3;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  opacity: 0.7;
}

.menu-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text);
}

.arrow {
  color: var(--color-text-muted);
  font-size: 32rpx;
}
