.page {
  padding: var(--spacing);
  min-height: 100vh;
  background: #F6F2EA;
}

.card {
  background: #FFFDF8;
  border-radius: 28rpx;
  padding: var(--spacing);
  margin-bottom: var(--spacing);
  border: 2rpx solid #EEE4D5;
  box-shadow: 0 10rpx 24rpx rgba(140, 116, 84, 0.08);
}

.profile-card {
  background: var(--color-card);
}

.profile-top {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing);
}

.avatar-wrap {
  margin-right: 16rpx;
  flex-shrink: 0;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 2rpx solid #D8B98A;
  box-sizing: border-box;
}

.avatar-placeholder {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 2rpx solid #D8B98A;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  background: #FFF7EB;
  box-sizing: border-box;
}

.profile-info {
  flex: 1;
}

.nickname {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #5B4330;
}

.edit-tip {
  display: block;
  margin-top: 4rpx;
}

.cloud-status {
  display: block;
  margin-top: 4rpx;
}

.stats-link-top {
  font-size: 26rpx;
}

.stats-link-top .mint {
  color: #A06E33;
}

.login-btn {
  margin: 0 0 var(--spacing);
  font-size: 26rpx;
  padding: 18rpx 0;
  background: linear-gradient(135deg, #E5C392 0%, #D8A969 100%) !important;
  color: #4B2F10 !important;
  box-shadow: 0 8rpx 18rpx rgba(199, 152, 91, 0.28);
}

.stats-row {
  display: flex;
  justify-content: space-around;
  text-align: center;
  padding-top: var(--spacing);
  border-top: 1rpx solid #E7DAC5;
}

.stat-num {
  display: block;
}

.stat-label {
  display: block;
  margin-top: 6rpx;
}

.quiz-banner-wrap {
  margin-bottom: var(--spacing);
  border-radius: var(--radius-card);
  overflow: hidden;
  box-shadow: 0 10rpx 24rpx rgba(140, 116, 84, 0.1);
}

.quiz-banner-image {
  width: 100%;
  height: 240rpx;
  display: block;
}

.section-title {
  margin-bottom: 16rpx;
}

.star-deco {
  font-size: 18rpx;
  color: #C6924D;
}

.badge-scroll {
  white-space: nowrap;
}

.badge-list {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 0;
}

.badge-item {
  width: 140rpx;
  text-align: center;
  padding: 16rpx 12rpx;
  border-radius: var(--radius-item);
  flex-shrink: 0;
}

.badge-item.unlocked {
  background: rgba(216, 169, 105, 0.16);
  border: 1rpx solid #D2A062;
}

.badge-item.locked {
  background: #F5EFE3;
  opacity: 0.55;
}

.badge-icon {
  display: block;
  font-size: 40rpx;
}

.badge-name {
  display: block;
  font-size: 22rpx;
  color: #5B4330;
  margin-top: 8rpx;
}

.badge-desc {
  display: block;
  font-size: 20rpx;
  margin-top: 4rpx;
  line-height: 1.3;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #E8DDCC;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  opacity: 0.7;
}

.menu-text {
  flex: 1;
  font-size: 26rpx;
  color: #5B4330;
}

.arrow {
  color: #B09C83;
  font-size: 32rpx;
}

.helper-text {
  color: #9A846B;
}

.module-amount {
  color: #6B4C2A;
}

.module-amount.mint {
  color: #9B6A2E;
}
