.page {
  padding: var(--spacing);
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: var(--spacing);
  margin-bottom: var(--spacing);
  box-shadow: var(--shadow-card);
}

.profile-top {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  margin-right: 16rpx;
  flex-shrink: 0;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-primary);
  box-sizing: border-box;
}

.avatar-placeholder {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  background: var(--color-card-white);
  box-sizing: border-box;
}

.profile-info {
  flex: 1;
}

.nickname {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text);
}

.edit-tip,
.cloud-status {
  display: block;
  margin-top: 4rpx;
}

.stats-link-top {
  font-size: 26rpx;
}

.login-btn {
  margin-top: var(--spacing);
  font-size: 26rpx;
  padding: 18rpx 0;
}

.badge-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.badge-all {
  font-size: 24rpx;
  color: var(--color-primary);
}

.badge-empty {
  text-align: center;
  padding: 24rpx 0 8rpx;
}

.badge-scroll {
  white-space: nowrap;
}

.badge-list {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 0;
}

.badge-item {
  width: 160rpx;
  text-align: center;
  padding: 14rpx;
  border-radius: var(--radius-item);
  flex-shrink: 0;
  background: rgba(212, 175, 55, 0.08);
  border: 1rpx solid rgba(212, 175, 55, 0.45);
  position: relative;
}

.badge-image {
  width: 82rpx;
  height: 82rpx;
  border-radius: 18rpx;
  margin: 0 auto;
  display: block;
}

.badge-name {
  display: block;
  font-size: 22rpx;
  color: var(--color-text);
  margin-top: 10rpx;
}

.badge-dot {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #f53f3f;
  top: 8rpx;
  right: 8rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  opacity: 0.7;
}

.menu-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text);
}

.arrow {
  color: var(--color-text-muted);
  font-size: 32rpx;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.48);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}

.modal {
  width: 620rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.modal-title {
  text-align: center;
  font-size: 30rpx;
  color: var(--color-text);
  font-weight: 600;
  display: block;
}

.modal-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  display: block;
  margin: 24rpx auto;
}

.modal-desc {
  font-size: 24rpx;
  color: var(--color-text);
  text-align: center;
  line-height: 1.5;
  display: block;
}

.modal-time {
  text-align: center;
  margin-top: 10rpx;
  display: block;
}

.modal-actions {
  margin-top: 26rpx;
  display: flex;
  gap: 14rpx;
}

.modal-actions-3 button {
  font-size: 24rpx;
  padding: 0;
}

.modal-actions button {
  flex: 1;
  border-radius: 16rpx;
}

.btn-sub {
  background: #f2f3f5;
  color: #4e5969;
}
