.page {
  padding: 24rpx;
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--color-border);
}

.profile-card {
  background: linear-gradient(160deg, #ffffff 0%, #eef8f3 100%);
}

.profile-top {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--color-primary-light);
  margin-right: 24rpx;
  border: 3rpx solid var(--color-primary);
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.nickname {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text);
}

.tip {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-top: 8rpx;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  text-align: center;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--color-border);
  border-bottom: 1rpx solid var(--color-border);
}

.stat-num {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-primary-dark);
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-top: 6rpx;
}

.stats-link {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 24rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

.arrow {
  color: var(--color-text-muted);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 20rpx;
}

.badge-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.badge-item {
  width: calc(25% - 15rpx);
  text-align: center;
  padding: 16rpx 8rpx;
  border-radius: 16rpx;
}

.badge-item.unlocked {
  background: var(--color-primary-light);
  border: 1rpx solid var(--color-primary);
}

.badge-item.locked {
  background: var(--color-input-bg);
  opacity: 0.55;
}

.badge-icon {
  display: block;
  font-size: 40rpx;
}

.badge-name {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: var(--color-text);
  border-bottom: 1rpx solid var(--color-border);
}

.menu-item:last-child {
  border-bottom: none;
}
