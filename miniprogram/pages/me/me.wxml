<view class="page">
  <view class="card profile-card">
    <view class="profile-top">
      <view class="avatar-wrap" bindtap="chooseAvatar">
        <image wx:if="{{user.avatarUrl}}" class="avatar" src="{{user.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar avatar-placeholder">👤</view>
      </view>
      <view class="profile-info">
        <text class="nickname">{{user.nickName}}</text>
        <text class="edit-tip helper-text" bindtap="chooseAvatar">编辑</text>
      </view>
      <view class="stats-link-top" bindtap="goStatistics">
        <text class="mint">存钱统计 ›</text>
      </view>
    </view>
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-num module-amount">{{stats.savingDays}}</text>
        <text class="stat-label helper-text">累计存钱天数</text>
      </view>
      <view class="stat-item">
        <text class="stat-num module-amount mint">¥{{stats.savedTotal}}</text>
        <text class="stat-label helper-text">已存总金额</text>
      </view>
      <view class="stat-item">
        <text class="stat-num module-amount">{{stats.recordCount}}</text>
        <text class="stat-label helper-text">存钱笔数</text>
      </view>
    </view>
  </view>

  <view class="card badge-card">
    <view class="section-title section-title-text">储蓄勋章 <text class="star-deco">✦</text></view>
    <scroll-view scroll-x class="badge-scroll" enable-flex>
      <view class="badge-list">
        <view class="badge-item {{item.unlocked ? 'unlocked badge-glow' : 'locked'}}" wx:for="{{badges}}" wx:key="id">
          <text class="badge-icon">{{item.icon}}</text>
          <text class="badge-name">{{item.name}}</text>
          <text class="badge-desc helper-text" wx:if="{{!item.unlocked}}">{{item.desc}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="card menu-card">
    <view class="menu-item" bindtap="goSettings">
      <text class="menu-icon">⚙️</text>
      <text class="menu-text">设置</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goHelp">
      <text class="menu-icon">📖</text>
      <text class="menu-text">使用帮助</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goPrivacy">
      <text class="menu-icon">📄</text>
      <text class="menu-text">用户协议 & 隐私政策</text>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
