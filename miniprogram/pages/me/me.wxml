<view class="page">
  <view class="card profile-card">
    <view class="profile-top">
      <view class="avatar-wrap">
        <image wx:if="{{user.avatarUrl}}" class="avatar" src="{{user.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar avatar-placeholder">👤</view>
      </view>
      <view class="profile-info">
        <text class="nickname">{{user.nickName}}</text>
        <text class="edit-tip helper-text" bindtap="goProfileEdit">编辑资料</text>
        <text class="cloud-status helper-text">{{cloudLogin.loggedIn ? '云端已登录' : '未登录云端'}}</text>
      </view>
      <view class="stats-link-top" bindtap="goStatistics">
        <text class="mint">存钱统计 ›</text>
      </view>
    </view>
    <button wx:if="{{!cloudLogin.loggedIn}}" class="login-btn btn-mint" bindtap="loginCloud">登录并同步云端</button>
  </view>

  <view class="card badge-card">
    <view class="badge-header">
      <text class="section-title-text">我的徽章</text>
      <text class="badge-all" bindtap="goBadges">全部 ></text>
    </view>

    <view wx:if="{{latestBadges.length === 0}}" class="badge-empty helper-text">
      还没有获得徽章，快去完成攒钱任务解锁吧
    </view>

    <scroll-view wx:else scroll-x class="badge-scroll" enable-flex>
      <view class="badge-list">
        <view class="badge-item unlocked" wx:for="{{latestBadges}}" wx:key="id" data-id="{{item.id}}" bindtap="openBadgeDetail">
          <image class="badge-image" src="{{item.displayImage}}" mode="aspectFill"></image>
          <view wx:if="{{item.isViewed === false}}" class="badge-dot"></view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="card menu-card">
    <view class="menu-item" bindtap="goSettings">
      <text class="menu-icon">⚙️</text>
      <text class="menu-text">设置</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goHelp">
      <text class="menu-icon">📖</text>
      <text class="menu-text">使用帮助</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goPrivacy">
      <text class="menu-icon">📄</text>
      <text class="menu-text">用户协议 & 隐私政策</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view wx:if="{{showUnlockPopup && activeUnlockBadge}}" class="mask">
    <view class="modal">
      <text class="modal-title">恭喜解锁全新徽章「{{activeUnlockBadge.name}}」</text>
      <image class="modal-image" src="{{activeUnlockBadge.image}}" mode="aspectFill"></image>
      <view class="modal-actions">
        <button class="btn-sub" bindtap="closeUnlockPopup">知道了</button>
        <button class="btn-mint" open-type="share" data-id="{{activeUnlockBadge.id}}" bindtap="startShareBadge">立即分享</button>
      </view>
    </view>
  </view>

  <view wx:if="{{showBadgeDetail && activeBadge}}" class="mask" bindtap="closeBadgeDetail">
    <view class="modal detail-modal" catchtap="noop">
      <text class="modal-title">{{activeBadge.name}}</text>
      <image class="modal-image" src="{{activeBadge.image}}" mode="aspectFill"></image>
      <text class="modal-desc">{{activeBadge.desc}}</text>
      <text class="modal-time helper-text">{{activeBadge.unlockTimeText}}</text>
      <view class="modal-actions">
        <button class="btn-mint" open-type="share" data-id="{{activeBadge.id}}" bindtap="startShareBadge">分享好友</button>
        <button class="btn-ghost" bindtap="closeBadgeDetail">关闭</button>
      </view>
    </view>
  </view>

  <canvas canvas-id="badgePosterCanvas" style="position: fixed; left: -9999px; top: -9999px; width: 750px; height: 1200px;"></canvas>
</view>
