<view class="page">
  <view class="card profile-card">
    <view class="profile-top" bindtap="chooseAvatar">
      <image wx:if="{{user.avatarUrl}}" class="avatar" src="{{user.avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="avatar avatar-placeholder">👤</view>
      <view class="profile-info">
        <text class="nickname">{{user.nickName}}</text>
        <text class="tip">点击设置头像昵称</text>
      </view>
    </view>
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-num">{{stats.savingDays}}</text>
        <text class="stat-label">存钱天数</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">¥{{stats.savedTotal}}</text>
        <text class="stat-label">已存金额</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{stats.recordCount}}</text>
        <text class="stat-label">存钱笔数</text>
      </view>
    </view>
    <view class="stats-link" bindtap="goStatistics">
      <text>存钱统计</text>
      <text class="arrow">></text>
    </view>
  </view>

  <view class="card badge-card">
    <view class="section-title">我的徽章</view>
    <view class="badge-list">
      <view class="badge-item {{item.unlocked ? 'unlocked' : 'locked'}}" wx:for="{{badges}}" wx:key="id">
        <text class="badge-icon">{{item.icon}}</text>
        <text class="badge-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <view class="card menu-card">
    <view class="menu-item" bindtap="goSettings">
      <text>设置</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item" bindtap="goHelp">
      <text>使用帮助</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item" bindtap="goPrivacy">
      <text>用户协议 & 隐私政策</text>
      <text class="arrow">></text>
    </view>
  </view>
</view>
