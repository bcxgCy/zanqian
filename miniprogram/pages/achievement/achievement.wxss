/* 打卡成就展示页样式 */

/* 页面容器 */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f5ff 0%, #ffffff 40%);
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 300rpx;
}

.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #e5e6eb;
  border-top-color: #165dff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #86909c;
}

/* ==================== 顶部背景区域 ==================== */
.header-bg {
  background: linear-gradient(135deg, #165dff 0%, #36bffa 100%);
  padding: 60rpx 40rpx 100rpx;
  border-radius: 0 0 48rpx 48rpx;
  position: relative;
  overflow: hidden;
}

.header-bg::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.header-bg::after {
  content: '';
  position: absolute;
  bottom: -60rpx;
  left: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.header-content {
  position: relative;
  z-index: 1;
}

/* 用户信息区 */
.user-section {
  display: flex;
  align-items: center;
  margin-bottom: 48rpx;
}

.avatar-wrapper {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
}

.avatar-icon {
  font-size: 48rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 34rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 6rpx;
}

.subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 核心成就数据 */
.achievement-highlight {
  text-align: center;
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
  backdrop-filter: blur(10rpx);
}

.achievement-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  display: block;
  margin-bottom: 12rpx;
}

.days-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 12rpx;
}

.days-number {
  font-size: 96rpx;
  font-weight: bold;
  color: #ffd700;
  line-height: 1;
  text-shadow: 0 4rpx 16rpx rgba(255, 215, 0, 0.3);
}

.days-unit {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  margin-left: 8rpx;
}

.achievement-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  display: block;
}

/* ==================== 详情卡片 ==================== */
.detail-card {
  margin: -48rpx 32rpx 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 36rpx;
  box-shadow: 0 8rpx 32rpx rgba(22, 93, 255, 0.12);
  position: relative;
  z-index: 10;
}

.plan-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.plan-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #1d2129;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-target {
  font-size: 28rpx;
  color: #165dff;
  font-weight: 500;
}

/* 进度条 */
.progress-section {
  margin-bottom: 28rpx;
}

.progress-bar-wrapper {
  height: 16rpx;
  background: #f2f3f5;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #165dff 0%, #36bffa 100%);
  border-radius: 8rpx;
  transition: width 0.6s ease;
  animation: progress-enter 0.8s ease-out;
}

@keyframes progress-enter {
  from { transform: scaleX(0); }
  to { transform: scaleX(1); }
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.progress-text {
  font-size: 26rpx;
  color: #86909c;
}

.progress-amount {
  font-size: 26rpx;
  color: #00b42a;
  font-weight: 500;
}

/* 本次打卡信息 */
.checkin-info {
  display: flex;
  align-items: center;
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 24rpx;
}

.checkin-item {
  flex: 1;
  text-align: center;
}

.checkin-label {
  font-size: 22rpx;
  color: #86909c;
  display: block;
  margin-bottom: 8rpx;
}

.checkin-value {
  font-size: 30rpx;
  color: #1d2129;
  font-weight: 500;
}

.checkin-value.highlight {
  color: #165dff;
  font-weight: bold;
  font-size: 34rpx;
}

.checkin-divider {
  width: 1rpx;
  height: 56rpx;
  background: #e5e6eb;
}

/* ==================== 鼓励文案 ==================== */
.encouragement {
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.encourage-text {
  font-size: 28rpx;
  color: #4e5969;
  text-align: center;
  display: block;
  line-height: 1.6;
}

/* ==================== 操作按钮区 ==================== */
.action-section {
  padding: 0 32rpx;
  margin-bottom: 48rpx;
}

.join-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  width: 100%;
  height: 96rpx;
  font-size: 34rpx;
  font-weight: bold;
  color: #ffffff !important;
  background: linear-gradient(135deg, #165dff 0%, #36bffa 100%) !important;
  border-radius: 48rpx;
  border: none !important;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(22, 93, 255, 0.35);
}

.join-btn::after {
  border: none;
}

.like-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  color: #4e5969 !important;
  background: #f7f8fa !important;
  border-radius: 44rpx;
  border: none !important;
}

.like-btn::after {
  border: none;
}

/* ==================== 底部提示 ==================== */
.footer-tip {
  text-align: center;
  padding: 0 32rpx 60rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #c9cdd4;
}
