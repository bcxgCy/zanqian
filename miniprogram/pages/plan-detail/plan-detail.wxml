<view class="page" wx:if="{{plan}}">
  <view class="card progress-card">
    <view class="progress-bar-full">
      <view class="progress-fill progress-fill-animated" style="width: {{summary.progress}}%"></view>
    </view>
    <view class="progress-grid">
      <view class="progress-item">
        <text class="num module-amount mint">¥{{summary.savedAmount}}</text>
        <text class="txt helper-text">已存入</text>
      </view>
      <view class="progress-item">
        <text class="num module-amount">{{summary.progress}}%</text>
        <text class="txt helper-text">完成度</text>
      </view>
      <view class="progress-item">
        <text class="num module-amount peach">¥{{summary.remaining}}</text>
        <text class="txt helper-text">剩余待存</text>
      </view>
    </view>
    <view class="meta helper-text">
      <text>起始日 {{plan.startDate}}</text>
      <text>坚持 {{persistDays}} 天</text>
    </view>
    <view class="plan-brief">
      <view class="plan-avatar-wrap">
        <image wx:if="{{plan.avatarUrl}}" class="plan-avatar" src="{{plan.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="icon-circle">🐷</view>
        <text class="plan-small-icon">{{plan.icon}}</text>
      </view>
      <view class="plan-info">
        <text class="name">{{plan.name}}</text>
        <text class="scheme helper-text">{{planTypeName}} · 目标 ¥{{plan.targetAmount}}</text>
      </view>
      <!-- 打卡提醒按钮：居右对齐 -->
      <button
        class="subscribe-btn-inline {{subscribeBtnStatus === 'active' ? 'btn-mint' : 'btn-disabled'}}"
        bindtap="onSubscribeTap"
        disabled="{{subscribeBtnStatus !== 'active'}}"
      >{{subscribeBtnText}}</button>
    </view>
  </view>

  <view class="section-title section-title-text">存钱明细</view>
  <view class="period-list">
    <view
      class="period-item {{item.completed ? 'done period-done-animate' : 'todo'}} {{item.dateClass}}"
      wx:for="{{plan.periods}}"
      wx:key="index"
      data-index="{{item.index}}"
      bindtap="openDeposit"
    >
      <view class="period-left">
        <text class="period-index">第{{item.index}}期</text>
        <text class="period-date helper-text">{{item.date}}</text>
      </view>
      <view class="period-right">
        <text class="period-amount">¥{{item.displayAmount}}</text>
        <text class="period-status helper-text">{{item.dateStatus}}</text>
      </view>
    </view>
  </view>

  <view class="plan-action-wrap">
    <!-- 分享此计划按钮（点击生成快照）- 放在第一位 -->
    <button
      class="share-plan-btn plan-state-btn btn-ghost"
      bindtap="onSharePlanTap"
    >分享此计划</button>

    <button
      wx:if="{{canPause}}"
      class="plan-state-btn pause-btn btn-ghost"
      bindtap="pausePlan"
    >暂停计划</button>
    <button
      wx:if="{{plan.paused}}"
      class="plan-state-btn btn-ghost"
      bindtap="restartPlan"
    >重启计划</button>

    <button class="delete-btn btn-ghost" bindtap="deletePlan">删除计划</button>
  </view>

  <deposit-sheet
    show="{{showSheet}}"
    period="{{selectedPeriod}}"
    readonly="{{sheetReadonly}}"
    bind:close="closeSheet"
    bind:confirm="onDepositConfirm"
  ></deposit-sheet>

  <!-- 🆕 打卡成功弹窗（含海报分享） -->
  <success-poster
    id="successPoster"
    show="{{showSuccessModal}}"
    plan="{{plan}}"
    savedAmount="{{successSavedAmount}}"
    consecutiveDays="{{successConsecutiveDays}}"
    bind:close="closeSuccessPoster"
  ></success-poster>

  <!-- 分享确认弹窗 -->
  <view class="share-modal-mask {{showShareModal ? 'show' : ''}}" bindtap="closeShareModal" catchtouchmove="preventTouchMove">
    <view class="share-modal-content {{showShareModal ? 'show' : ''}}" catchtap="preventTouchMove">
      <!-- 标题栏 -->
      <view class="share-modal-header">
        <text class="share-modal-title">分享计划模板</text>
        <view class="share-modal-close" bindtap="closeShareModal">
          <text>✕</text>
        </view>
      </view>

      <!-- 内容区 -->
      <view class="share-modal-body">
        <!-- 加载状态 -->
        <view class="share-loading" wx:if="{{sharePreparing}}">
          <view class="loading-spinner"></view>
          <text class="loading-text">正在准备分享内容...</text>
        </view>

        <!-- 准备就绪 -->
        <view class="share-ready" wx:if="{{!sharePreparing && shareSnapshotId}}">
          <view class="ready-icon">✅</view>
          <text class="ready-title">分享内容已准备好！</text>
          <text class="ready-desc">好友可以复制这个计划模板，创建属于自己的存钱计划</text>

          <!-- 真正的分享按钮 -->
          <button
            class="real-share-btn"
            open-type="share"
            data-share-type="template"
          >发送给微信好友</button>
        </view>

        <!-- 失败状态 -->
        <view class="share-error" wx:if="{{!sharePreparing && !shareSnapshotId}}">
          <text class="error-icon">⚠️</text>
          <text class="error-text">{{shareError || '准备失败，请重试'}}</text>
          <button class="retry-btn" bindtap="onSharePlanTap" size="mini">重新尝试</button>
        </view>
      </view>
    </view>
  </view>
</view>
