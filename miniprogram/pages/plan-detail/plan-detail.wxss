.page {
  padding: var(--spacing);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: var(--spacing);
  margin-bottom: var(--spacing);
  box-shadow: var(--shadow-card);
}

.progress-bar-full {
  height: 12rpx;
  background: var(--color-border);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: var(--spacing);
}

.progress-fill {
  height: 100%;
  border-radius: 6rpx;
}

.progress-grid {
  display: flex;
  justify-content: space-around;
  text-align: center;
  margin-bottom: var(--spacing);
}

.progress-item .num {
  display: block;
}

.progress-item .txt {
  display: block;
  margin-top: 6rpx;
}

.meta {
  display: flex;
  justify-content: space-between;
  padding-bottom: var(--spacing);
  border-bottom: 1rpx solid var(--color-border);
  margin-bottom: var(--spacing);
}

.plan-brief {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 心愿信息区域：占据剩余空间 */
.plan-brief .plan-info {
  flex: 1;
  min-width: 0; /* 防止文字溢出 */
}

.plan-avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.plan-brief .icon-circle {
  width: 64rpx;
  height: 64rpx;
  font-size: 36rpx;
}

.plan-brief .plan-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: block;
  flex-shrink: 0;
}

.plan-brief .plan-small-icon {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #FFFFFF;
  font-size: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
}

.scheme {
  display: block;
  margin-top: 4rpx;
}

.section-title {
  margin: 0 0 16rpx 4rpx;
}

.period-item {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx var(--spacing);
  border-radius: var(--radius-item);
  margin-bottom: 12rpx;
}

.period-item.done {
  background: var(--color-done-bg);
}

.period-item.todo {
  background: var(--color-card-white);
  border: 1rpx solid var(--color-border);
}

.period-item.is-overdue {
  background: #f5f5f5;
  border-color: #e5e5e5;
  opacity: 0.68;
}

.period-item.is-overdue .period-index,
.period-item.is-overdue .period-date,
.period-item.is-overdue .period-amount,
.period-item.is-overdue .period-status {
  color: #9a8f8f;
}

.period-item.is-early {
  background: #f6f8fb;
  border-color: #dfe7f0;
  opacity: 0.58;
}

.period-item.is-early .period-index,
.period-item.is-early .period-date,
.period-item.is-early .period-amount,
.period-item.is-early .period-status {
  color: #8f9bad;
}

.period-index {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text);
}

.period-date {
  display: block;
  margin-top: 4rpx;
}

.period-amount {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  text-align: right;
  color: var(--color-text);
}

.period-status {
  display: block;
  text-align: right;
  margin-top: 4rpx;
}

.plan-action-wrap {
  margin-top: 32rpx;
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.plan-state-btn,
.subscribe-btn,
.delete-btn {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  line-height: 1;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  box-sizing: border-box;
}
.plan-state-btn {
  color: rgba(102, 126, 234) !important;
  border: 1rpx solid rgba(102, 126, 234, 0.35) !important;
}

.delete-btn {
  color: var(--color-danger) !important;
  border: 1rpx solid rgba(245, 63, 63, 0.35) !important;
}

.pause-btn {
  color: var(--color-warning) !important;
  border: 1rpx solid rgba(255, 125, 0, 0.35) !important;
}

/* 订阅按钮样式 */
.subscribe-btn.btn-mint {
  background: linear-gradient(135deg, #4ecdc4, #44a08d);
  color: #fff !important;
  border: none !important;
  font-weight: 500;
}

.subscribe-btn.btn-disabled {
  background: #f5f5f5;
  color: #999 !important;
  border: 1rpx solid #eee !important;
}

.subscribe-btn.btn-disabled[disabled] {
  opacity: 0.8;
}

/* 内联订阅按钮样式（在名称右边） */
.subscribe-btn-inline {
  flex-shrink: 0;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 22rpx;
  padding: 0 20rpx;
  border-radius: 32rpx;
  margin-left: auto; /* 居右对齐 */
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 280rpx;
}

.subscribe-btn-inline.btn-mint {
  background: linear-gradient(135deg, #4ecdc4, #44a08d);
  color: #fff !important;
  border: none !important;
  font-weight: 500;
}

.subscribe-btn-inline.btn-disabled {
  background: #f5f5f5;
  color: #999 !important;
  border: 1rpx solid #eee !important;
}

.subscribe-btn-inline.btn-disabled[disabled] {
  opacity: 0.8;
}

/* 分享此计划按钮样式 - 紫色主题（突出显示） */
.share-plan-btn {
  flex: 1;
  color: #667eea !important;
  border: 1rpx solid #667eea !important;
}

/* 分享确认弹窗样式 */
.share-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.3s ease;
  visibility: hidden;
  opacity: 0;
}

.share-modal-mask.show {
  background-color: rgba(0, 0, 0, 0.6);
  visibility: visible;
  opacity: 1;
}

.share-modal-content {
  width: 85%;
  max-width: 600rpx;
  background-color: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  transform: scale(0.9);
  transition: transform 0.3s ease;
  display: flex;
  flex-direction: column;
  visibility: hidden;
  opacity: 0;
}

.share-modal-content.show {
  transform: scale(1);
  visibility: visible;
  opacity: 1;
}

.share-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.share-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.share-modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: #f5f5f5;
  color: #666;
  font-size: 28rpx;
}

.share-modal-close:active {
  background-color: #eee;
}

.share-modal-body {
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 300rpx;
}

/* 加载状态 */
.share-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #666;
}

/* 准备就绪 */
.share-ready {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.ready-icon {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 48rpx;
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
  border-radius: 50%;
  margin-bottom: 8rpx;
}

.ready-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.ready-desc {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.real-share-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  color: #fff !important;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border: none !important;
  border-radius: 44rpx;
  margin-top: 16rpx;
  padding: 0;
}

.real-share-btn:active {
  opacity: 0.9;
}

/* 失败状态 */
.share-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.error-icon {
  font-size: 56rpx;
}

.error-text {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.retry-btn {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff !important;
  font-size: 26rpx;
  border: none;
  border-radius: 40rpx;
  padding: 12rpx 40rpx;
}
