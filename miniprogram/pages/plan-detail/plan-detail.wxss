.page {
  padding: var(--spacing);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: var(--spacing);
  margin-bottom: var(--spacing);
  box-shadow: var(--shadow-card);
}

.progress-bar-full {
  height: 12rpx;
  background: var(--color-border);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: var(--spacing);
}

.progress-fill {
  height: 100%;
  border-radius: 6rpx;
}

.progress-grid {
  display: flex;
  justify-content: space-around;
  text-align: center;
  margin-bottom: var(--spacing);
}

.progress-item .num {
  display: block;
}

.progress-item .txt {
  display: block;
  margin-top: 6rpx;
}

.meta {
  display: flex;
  justify-content: space-between;
  padding-bottom: var(--spacing);
  border-bottom: 1rpx solid var(--color-border);
  margin-bottom: var(--spacing);
}

.plan-brief {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.plan-brief .icon-circle {
  width: 64rpx;
  height: 64rpx;
  font-size: 32rpx;
}

.name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
}

.scheme {
  display: block;
  margin-top: 4rpx;
}

.section-title {
  margin: 0 0 16rpx 4rpx;
}

.period-item {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx var(--spacing);
  border-radius: var(--radius-item);
  margin-bottom: 12rpx;
}

.period-item.done {
  background: var(--color-done-bg);
}

.period-item.todo {
  background: var(--color-card-white);
  border: 1rpx solid var(--color-border);
}

.period-index {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text);
}

.period-date {
  display: block;
  margin-top: 4rpx;
}

.period-amount {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  text-align: right;
  color: var(--color-text);
}

.period-status {
  display: block;
  text-align: right;
  margin-top: 4rpx;
}

.period-check {
  position: absolute;
  right: 16rpx;
  bottom: 12rpx;
  font-size: 36rpx;
  color: rgba(154, 223, 214, 0.45);
}

.delete-wrap {
  margin-top: 32rpx;
}

.delete-btn {
  font-size: 26rpx;
  border: 1rpx solid var(--color-border) !important;
}
