.page {
  padding: var(--spacing);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: var(--spacing);
  margin-bottom: var(--spacing);
  box-shadow: var(--shadow-card);
}

.progress-bar-full {
  height: 12rpx;
  background: var(--color-border);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: var(--spacing);
}

.progress-fill {
  height: 100%;
  border-radius: 6rpx;
}

.progress-grid {
  display: flex;
  justify-content: space-around;
  text-align: center;
  margin-bottom: var(--spacing);
}

.progress-item .num {
  display: block;
}

.progress-item .txt {
  display: block;
  margin-top: 6rpx;
}

.meta {
  display: flex;
  justify-content: space-between;
  padding-bottom: var(--spacing);
  border-bottom: 1rpx solid var(--color-border);
  margin-bottom: var(--spacing);
}

.plan-brief {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 心愿信息区域：占据剩余空间 */
.plan-brief .plan-info {
  flex: 1;
  min-width: 0; /* 防止文字溢出 */
}

.plan-avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.plan-brief .icon-circle {
  width: 64rpx;
  height: 64rpx;
  font-size: 36rpx;
}

.plan-brief .plan-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: block;
  flex-shrink: 0;
}

.plan-brief .plan-small-icon {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #FFFFFF;
  font-size: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
}

.scheme {
  display: block;
  margin-top: 4rpx;
}

.section-title {
  margin: 0 0 16rpx 4rpx;
}

.period-item {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx var(--spacing);
  border-radius: var(--radius-item);
  margin-bottom: 12rpx;
}

.period-item.done {
  background: var(--color-done-bg);
}

.period-item.todo {
  background: var(--color-card-white);
  border: 1rpx solid var(--color-border);
}

.period-item.is-overdue {
  background: #f5f5f5;
  border-color: #e5e5e5;
  opacity: 0.68;
}

.period-item.is-overdue .period-index,
.period-item.is-overdue .period-date,
.period-item.is-overdue .period-amount,
.period-item.is-overdue .period-status {
  color: #9a8f8f;
}

.period-item.is-early {
  background: #f6f8fb;
  border-color: #dfe7f0;
  opacity: 0.58;
}

.period-item.is-early .period-index,
.period-item.is-early .period-date,
.period-item.is-early .period-amount,
.period-item.is-early .period-status {
  color: #8f9bad;
}

.period-index {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text);
}

.period-date {
  display: block;
  margin-top: 4rpx;
}

.period-amount {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  text-align: right;
  color: var(--color-text);
}

.period-status {
  display: block;
  text-align: right;
  margin-top: 4rpx;
}

.plan-action-wrap {
  margin-top: 32rpx;
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.plan-state-btn,
.subscribe-btn,
.delete-btn {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  line-height: 1;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  box-sizing: border-box;
}

.delete-btn {
  color: var(--color-danger) !important;
  border: 1rpx solid rgba(245, 63, 63, 0.35) !important;
}

.pause-btn {
  color: var(--color-warning) !important;
  border: 1rpx solid rgba(255, 125, 0, 0.35) !important;
}

/* 订阅按钮样式 */
.subscribe-btn.btn-mint {
  background: linear-gradient(135deg, #4ecdc4, #44a08d);
  color: #fff !important;
  border: none !important;
  font-weight: 500;
}

.subscribe-btn.btn-disabled {
  background: #f5f5f5;
  color: #999 !important;
  border: 1rpx solid #eee !important;
}

.subscribe-btn.btn-disabled[disabled] {
  opacity: 0.8;
}

/* 内联订阅按钮样式（在名称右边） */
.subscribe-btn-inline {
  flex-shrink: 0;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 22rpx;
  padding: 0 20rpx;
  border-radius: 32rpx;
  margin-left: auto; /* 居右对齐 */
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 280rpx;
}

.subscribe-btn-inline.btn-mint {
  background: linear-gradient(135deg, #4ecdc4, #44a08d);
  color: #fff !important;
  border: none !important;
  font-weight: 500;
}

.subscribe-btn-inline.btn-disabled {
  background: #f5f5f5;
  color: #999 !important;
  border: 1rpx solid #eee !important;
}

.subscribe-btn-inline.btn-disabled[disabled] {
  opacity: 0.8;
}
