.page {
  padding: var(--spacing);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: var(--spacing);
  box-shadow: var(--shadow-card);
}

.overview {
  text-align: center;
  margin-bottom: var(--spacing);
}

.overview-title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.overview-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text);
}

.star-deco {
  font-size: 20rpx;
  color: var(--color-primary);
  margin-left: 8rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
}

.amount {
  display: block;
  margin-bottom: var(--spacing);
}

.divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 0 0 var(--spacing);
}

.overview-sub {
  display: flex;
  justify-content: space-between;
}

.sub-item {
  flex: 1;
  text-align: center;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.stats-link {
  display: flex;
  align-items: center;
  font-size: 26rpx;
}

.plan-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.plan-card {
  position: relative;
  background: var(--color-card);
  border-radius: var(--radius-item);
  padding: 20rpx;
  overflow: hidden;
}

.plan-done {
  border: 1rpx solid var(--color-primary-light);
}

.plan-row {
  display: flex;
  align-items: flex-start;
}

.plan-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  font-size: 36rpx;
  margin-right: 16rpx;
}

.plan-body {
  flex: 1;
  min-width: 0;
}

.plan-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.plan-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
}

.plan-arrow {
  color: var(--color-text-muted);
  font-size: 32rpx;
  line-height: 1;
}

.plan-type {
  display: block;
  margin-top: 4rpx;
  margin-bottom: 12rpx;
}

.progress-bar {
  height: 10rpx;
  background: var(--color-border);
  border-radius: 5rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 5rpx;
}

.plan-meta {
  display: block;
}

.done-watermark {
  position: absolute;
  right: 16rpx;
  bottom: 12rpx;
  font-size: 48rpx;
  color: rgba(154, 223, 214, 0.35);
  font-weight: 300;
}

.empty {
  text-align: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-text {
  display: block;
  line-height: 1.6;
}

.page .fab {
  bottom: calc(120rpx + env(safe-area-inset-bottom));
}
