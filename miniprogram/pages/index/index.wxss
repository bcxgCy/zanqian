.page {
  padding: var(--spacing);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: var(--spacing);
  box-shadow: var(--shadow-card);
}

.overview {
  text-align: center;
  margin-bottom: var(--spacing);
  background: var(--color-card);
}

.overview-title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.overview-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text);
}

.star-deco {
  font-size: 20rpx;
  color: var(--color-primary);
  margin-left: 8rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
}

.amount {
  display: block;
  margin-bottom: 10rpx;
}

.wish-line {
  display: block;
  color: var(--color-gold);
  font-size: 24rpx;
  margin-bottom: var(--spacing);
}

.divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 0 0 var(--spacing);
}

.overview-sub {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.sub-item {
  flex: 1;
  text-align: center;
  background: #FFFFFF;
  border-radius: var(--radius-item);
  padding: 16rpx 8rpx;
}

.sub-label,
.sub-value {
  display: block;
}

.sub-value {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.stats-link {
  display: flex;
  align-items: center;
  font-size: 26rpx;
}

.plan-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.plan-card {
  position: relative;
  background: var(--color-card);
  border-radius: var(--radius-item);
  padding: 20rpx;
  overflow: hidden;
  border: 1rpx solid var(--color-border);
}

.plan-done {
  border: 1rpx solid var(--color-primary-light);
}

.plan-paused {
  background: var(--color-disabled-bg);
  border-color: var(--color-border);
  box-shadow: none;
}

.plan-paused .piggy-icon,
.plan-paused .plan-avatar,
.plan-paused .progress-bar {
  opacity: 0.58;
}

.plan-paused .progress-fill {
  background: #C9CDD4;
  animation: none;
}

.plan-paused .plan-name,
.plan-paused .plan-percent,
.plan-paused .plan-meta,
.plan-paused .next-save,
.plan-paused .plan-type {
  color: var(--color-text-muted);
}

.plan-paused .plan-action {
  color: var(--color-text-muted);
  background: #FFFFFF;
  border: 1rpx solid var(--color-border);
}

.plan-row {
  display: flex;
  align-items: flex-start;
}

.plan-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  margin-right: 16rpx;
}

.piggy-icon {
  position: relative;
  border-radius: 50%;
  background: rgba(212, 175, 55, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.piggy-mark {
  font-size: 40rpx;
}

.plan-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}

.plan-small-icon {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #FFFFFF;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plan-body {
  flex: 1;
  min-width: 0;
}

.plan-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.plan-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
}

.plan-arrow {
  color: var(--color-text-muted);
  font-size: 32rpx;
  line-height: 1;
}

.plan-percent {
  color: var(--color-success);
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.plan-type {
  display: block;
  margin-top: 4rpx;
  margin-bottom: 12rpx;
}

.progress-bar {
  height: 14rpx;
  background: var(--progress-bg);
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
}

.plan-meta {
  display: block;
}

.plan-action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
}

.next-save {
  flex: 1;
  min-width: 0;
}

.plan-action {
  flex-shrink: 0;
  min-width: 120rpx;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
}

.plan-action-primary {
  color: #FFFFFF;
  background: var(--color-primary);
}

.plan-action-secondary {
  color: var(--color-text);
  background: #FFFFFF;
  border: 1rpx solid var(--color-border);
}

.empty {
  text-align: center;
  padding: 100rpx 40rpx;
  background: #FFFFFF;
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.empty-piggy {
  width: 116rpx;
  height: 116rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: rgba(212, 175, 55, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  color: var(--color-text);
  font-weight: 500;
  margin-bottom: 24rpx;
}

.empty-text {
  display: block;
  line-height: 1.6;
}

.page .fab {
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  flex-direction: column;
  transition: transform 0.18s ease;
}

.page .fab:active {
  transform: scale(0.94);
}

.page .fab-icon {
  font-size: 40rpx;
  line-height: 40rpx;
}

.fab-label {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: #FFFFFF;
  line-height: 1;
}
