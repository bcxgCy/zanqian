.page {
  background: #FFF9F0;
  padding: var(--spacing);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: var(--spacing);
  box-shadow: var(--shadow-card);
}

.overview {
  text-align: left;
  margin-bottom: var(--spacing);
  background: linear-gradient(135deg, rgb(237,249,162) 0%, rgb(238,248,190) 50%, #EAF6DD 100%);
  border-radius: 40rpx;
  border: 4rpx solid #FFFFFF;
  padding: 36rpx 24rpx 24rpx 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(168, 216, 78, 0.15), 0 2rpx 8rpx rgba(255, 255, 255, 0.7);
  min-height: 360rpx;
}

.overview-title-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  margin-bottom: 20rpx;
}

.overview-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text);
}

.overview-title-top{
  color: #666666;
  font-size: 24rpx;
}

.star-deco {
  font-size: 20rpx;
  color: var(--color-primary);
  margin-left: 8rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #8C7F6E;
}

.amount {
  display: flex;
  align-items: baseline;
  margin-bottom: 28rpx;
  font-weight: 700;
  color: #3A3228;
}

.amount-symbol {
  font-size: 44rpx;
  margin-right: 6rpx;
}

.amount-number {
  font-size: 64rpx;
  line-height: 1;
}

.overview-tags {
  display: flex;
  justify-content: flex-start;
  flex-wrap: wrap;
  gap: 16rpx;
}

.overview-tag {
  background: rgb(184,222,90);
  border-radius: 999rpx;
  padding: 8rpx 12rpx;
  font-size: 18rpx;
  line-height: 1.2;
  color: #FFFFFF;
  font-weight: 500;
}

.tag-daka{
  background: rgb(238,173,77);
}

.month-overview-card {
  margin-top: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 2rpx solid #A8D84E;
  padding: 16rpx;
}

.month-overview-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.month-overview-title {
  font-size: 20rpx;
  font-weight: 600;
  color: #2F2A22;
}

.month-picker-pill {
  background: #F2F2F2;
  border-radius: 999rpx;
  /* padding: 10rpx 20rpx; */
  height: 32rpx;
  line-height: 32rpx;
  align-items: center;
  padding: 0 12rpx;
  font-size: 22rpx;
  color: #666666;
}

.month-overview-stats {
  display: flex;
}

.month-stat-item {
  flex: 1;
  text-align: left;
  padding: 0 16rpx;
  box-sizing: border-box;
}

.month-stat-item:nth-child(2),
.month-stat-item:nth-child(3) {
  padding-left: 40rpx;
}

.month-stat-item:not(:last-child) {
  border-right: 1rpx solid #DDE6CF;
}

.month-stat-label {
  display: block;
  font-size: 22rpx;
  color: #8A8A8A;
  margin-bottom: 10rpx;
}

.month-stat-value {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1F1F1F;
}

.month-stat-value-green {
  color: #A8D84E;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 32rpx;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.section-title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #2F2A22;
}

.reminder-btn {
  min-width: 112rpx;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 2rpx solid #A8D84E;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.reminder-btn-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #5E8F20;
}

.quick-actions {
  display: flex;
  align-items: stretch;
  margin-bottom: 16rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(168, 216, 78, 0.15), 0 2rpx 8rpx rgba(255, 255, 255, 0.7);
  padding: 0;
}

.quick-action-item {
  flex: 1;
  min-height: 156rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.quick-action-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 12rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}

.quick-action-icon-image {
  width: 66rpx;
  height: 66rpx;
  border-radius: 12rpx;
  display: block;
}

.quick-action-icon-green {
  background: rgba(121, 209, 73, 0.5);
}

.quick-action-icon-yellow {
  background: rgba(248, 184, 52, 0.5);
}

.quick-action-icon-red {
  background: rgba(243, 113, 113, 0.5);
}

.quick-action-icon-blue {
  background: rgba(100, 165, 241, 0.5);
}

.quick-action-text {
  font-size: 20rpx;
  font-weight: 500;
  color: #666666;
}

.stats-link {
  display: flex;
  align-items: center;
  font-size: 26rpx;
}

.plan-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.plan-card {
  position: relative;
  background: #FFFFFF;
  border-radius: 40rpx;
  padding: 24rpx;
  overflow: hidden;
  border: 2rpx solid #EEF4E3;
  box-shadow: 0 8rpx 32rpx rgba(168, 216, 78, 0.12), 0 2rpx 8rpx rgba(255, 255, 255, 0.7);
}

.plan-done {
  border: 1rpx solid var(--color-primary-light);
}

.plan-paused {
  background: var(--color-disabled-bg);
  border-color: var(--color-border);
  box-shadow: none;
}

.plan-paused .piggy-icon,
.plan-paused .plan-avatar,
.plan-paused .progress-bar {
  opacity: 0.58;
}

.plan-paused .progress-fill {
  background: #C9CDD4;
  animation: none;
}

.plan-paused .plan-name,
.plan-paused .plan-amount-text,
.plan-paused .plan-next-save,
.plan-paused .plan-type-inline {
  color: var(--color-text-muted);
}

.plan-paused .plan-action {
  color: var(--color-text-muted);
  background: #FFFFFF;
  border: 1rpx solid var(--color-border);
}

.plan-top {
  display: flex;
  align-items: center;
}

.plan-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  margin-right: 16rpx;
}

.piggy-icon {
  position: relative;
  border-radius: 50%;
  background: rgba(212, 175, 55, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.piggy-mark {
  font-size: 40rpx;
}

.plan-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}

.plan-small-icon {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #FFFFFF;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plan-main {
  flex: 1;
  min-width: 0;
}

.plan-main-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.plan-main-row-top {
  margin-bottom: 14rpx;
}

.plan-main-row-sub {
  gap: 12rpx;
}

.plan-title-wrap {
  flex: 1;
  min-width: 0;
}

.plan-title-line {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  white-space: nowrap;
  overflow: hidden;
}

.plan-name {
  flex: 0 1 auto;
  /* min-width: 120rpx; */
  max-width: 70%;
  font-size: 28rpx;
  font-weight: 600;
  color: #2F2A22;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.plan-type-inline {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #7A746A;
  margin-left: 2rpx;
}

.progress-bar {
  margin-top: 18rpx;
  height: 14rpx;
  background: #ECF3DE;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #79D149 0%, #A8D84E 100%);
}

.plan-amount-text,
.plan-next-save {
  font-size: 24rpx;
  color: #6E685E;
}

.plan-amount-text {
  flex: 1;
  min-width: 0;
}

.plan-next-save {
  flex-shrink: 0;
}

.plan-action {
  flex-shrink: 0;
  min-width: 132rpx;
  height: 50rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
}

.plan-action-primary {
  color: #FFFFFF;
  background: linear-gradient(90deg, #79D149 0%, #A8D84E 100%);
  box-shadow: 0 6rpx 14rpx rgba(121, 209, 73, 0.28);
}

.plan-action-secondary {
  color: #5E8F20;
  background: #FFFFFF;
  border: 2rpx solid #B8D989;
}

.empty {
  text-align: center;
  padding: 100rpx 40rpx;
  background: #FFFFFF;
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.empty-piggy {
  width: 116rpx;
  height: 116rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: rgba(212, 175, 55, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  color: var(--color-text);
  font-weight: 500;
  margin-bottom: 24rpx;
}

.empty-text {
  display: block;
  line-height: 1.6;
}

.page .fab {
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  flex-direction: column;
  transition: transform 0.18s ease;
}

.page .fab:active {
  transform: scale(0.94);
}

.page .fab-icon {
  font-size: 40rpx;
  line-height: 40rpx;
}

.fab-label {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: #FFFFFF;
  line-height: 1;
}

.quiz-popup-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2500;
}

.quiz-popup {
  width: 86%;
  max-width: 512rpx;
  background: transparent;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: none;
}

.quiz-popup-image {
  width: 100%;
  height: 682rpx;
  border-radius: 28rpx;
  display: block;
  box-shadow: 0 20rpx 48rpx rgba(0, 0, 0, 0.22);
}

.quiz-popup-close-wrap {
  display: flex;
  justify-content: center;
  margin-top: 22rpx;
}

.quiz-popup-close-btn {
  width: 72rpx;
  height: 72rpx;
  box-sizing: border-box;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 44rpx;
  font-weight: 400;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
