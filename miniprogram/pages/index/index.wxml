<view class="page">
  <!-- 区域 A：顶部概览大卡片 -->
  <view class="overview card">
    <view class="overview-title-row">
      <text class="overview-title-top">已存金额（元）</text>
    </view>
    <view class="amount page-amount">
      <text class="amount-symbol">¥</text>
      <text class="amount-number">{{overview.savedTotal}}</text>
    </view>
    <view class="overview-tags">
      <text class="overview-tag">较上月增加 ¥{{monthIncreaseAmount}}</text>
      <text class="overview-tag tag-daka">连续打卡 {{streakDays}} 天</text>
    </view>

    <view class="month-overview-card">
      <view class="month-overview-head">
        <text class="month-overview-title">本月存钱概览</text>
        <picker mode="date" fields="month" value="{{selectedMonthPickerValue}}" bindchange="handleMonthChange">
          <view class="month-picker-pill">{{selectedMonthLabel}}</view>
        </picker>
      </view>
      <view class="month-overview-stats">
        <view class="month-stat-item">
          <text class="month-stat-label">目标金额</text>
          <text class="month-stat-value month-stat-value-green">¥{{monthOverview.targetAmount}}</text>
        </view>
        <view class="month-stat-item">
          <text class="month-stat-label">存入金额</text>
          <text class="month-stat-value">¥{{monthOverview.savedAmount}}</text>
        </view>
        <view class="month-stat-item">
          <text class="month-stat-label">占比</text>
          <text class="month-stat-value">{{monthOverview.ratio}}%</text>
        </view>
      </view>
    </view>
  </view>

  <view class="quick-actions card">
    <view class="quick-action-item" bindtap="goAddPlan">
      <view class="quick-action-icon quick-action-icon-green">
        <image class="quick-action-icon-image" src="cloud://cloud1-d1g1g2urwd9ff5a66.636c-cloud1-d1g1g2urwd9ff5a66-1462912205/other/nav-add.jpg" mode="aspectFill"></image>
      </view>
      <text class="quick-action-text">新增计划</text>
    </view>
    <view class="quick-action-item" bindtap="goCalculator">
      <view class="quick-action-icon quick-action-icon-yellow">
        <image class="quick-action-icon-image" src="cloud://cloud1-d1g1g2urwd9ff5a66.636c-cloud1-d1g1g2urwd9ff5a66-1462912205/other/nav-calc.jpg" mode="aspectFill"></image>
      </view>
      <text class="quick-action-text">存款计算器</text>
    </view>
    <view class="quick-action-item" bindtap="goStatistics">
      <view class="quick-action-icon quick-action-icon-red">
        <image class="quick-action-icon-image" src="cloud://cloud1-d1g1g2urwd9ff5a66.636c-cloud1-d1g1g2urwd9ff5a66-1462912205/other/nav-tongji.jpg" mode="aspectFill"></image>
      </view>
      <text class="quick-action-text">数据统计</text>
    </view>
    <view class="quick-action-item" bindtap="goAllPlans">
      <view class="quick-action-icon quick-action-icon-blue">
        <image class="quick-action-icon-image" src="cloud://cloud1-d1g1g2urwd9ff5a66.636c-cloud1-d1g1g2urwd9ff5a66-1462912205/other/nav-all.jpg" mode="aspectFill"></image>
      </view>
      <text class="quick-action-text">全部计划</text>
    </view>
  </view>

  <!-- 区域 C：列表头部 -->
  <view class="section-header">
    <text class="section-title-text">近期待打卡计划</text>
    <view class="reminder-btn" bindtap="goReminderSettings">
      <text class="reminder-btn-text">提醒</text>
    </view>
  </view>

  <!-- 区域 D：计划列表 -->
  <view class="plan-list">
    <view
      class="plan-card {{item.progress >= 100 ? 'plan-done' : ''}} {{item.paused ? 'plan-paused' : ''}}"
      wx:for="{{plans}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goPlanDetail"
    >
      <view class="plan-top">
        <view class="piggy-icon plan-icon-wrap">
          <image wx:if="{{item.avatarUrl}}" class="plan-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
          <text wx:else class="piggy-mark">🐷</text>
          <text class="plan-small-icon">{{item.icon}}</text>
        </view>
        <view class="plan-main">
          <view class="plan-main-row plan-main-row-top">
            <view class="plan-title-wrap">
              <view class="plan-title-line">
                <text class="plan-name">{{item.name}}</text>
                <text class="plan-type-inline">{{item.planTypeName}}</text>
              </view>
            </view>
            <view
              class="plan-action {{item.actionType === 'checkin' ? 'plan-action-primary' : 'plan-action-secondary'}}"
              data-id="{{item.id}}"
              data-action="{{item.actionType}}"
              data-period-index="{{item.nextPeriodIndex}}"
              catchtap="handlePlanAction"
            >{{item.actionText}}</view>
          </view>

          <view class="plan-main-row plan-main-row-sub">
            <text class="plan-amount-text">已存 ¥{{item.savedAmount}} / ¥{{item.targetAmount}}</text>
            <text class="plan-next-save">{{item.nextSaveText}}</text>
          </view>
        </view>
      </view>

      <view class="progress-bar">
        <view class="progress-fill progress-fill-animated" style="width: {{item.progress}}%"></view>
      </view>
    </view>

    <view class="empty" wx:if="{{!plans.length}}">
      <view class="empty-piggy">🐷</view>
      <text class="empty-title">还没有存钱心愿</text>
      <text class="empty-text helper-text">点击右下角 + 开启第一份攒钱目标</text>
    </view>
  </view>

  <view wx:if="{{showQuizPopup}}" class="quiz-popup-mask" catchtouchmove="preventTouchMove" bindtap="closeQuizPopup">
    <view class="quiz-popup" catchtap="preventTouchMove">
      <image class="quiz-popup-image" src="{{quizPopupImage}}" mode="aspectFill" bindtap="openSavingQuiz"></image>
      <view class="quiz-popup-close-wrap">
        <view class="quiz-popup-close-btn" bindtap="closeQuizPopup">×</view>
      </view>
    </view>
  </view>
</view>
