.page {
  min-height: 100vh;
  background: #FFF9F0;
  padding: var(--spacing);
  box-sizing: border-box;
}

.card-shell {
  background: #FFFFFF;
  border: 2rpx solid #EEF4E3;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(168, 216, 78, 0.12), 0 2rpx 8rpx rgba(255, 255, 255, 0.7);
}

.tabs {
  display: flex;
  padding: 10rpx;
  margin-bottom: 18rpx;
}

.tab {
  flex: 1;
  text-align: center;
  height: 66rpx;
  line-height: 66rpx;
  border-radius: 999rpx;
  color: #7A746A;
  font-size: 24rpx;
  font-weight: 500;
  background: #FFF9F0;
}

.tab.active {
  background: #E6B34E;
  color: #FFFFFF;
  font-weight: 700;
}

.card {
  background: #FFFFFF;
  border: 2rpx solid #F3E6D2;
  border-radius: 26rpx;
  padding: 18rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 8rpx 18rpx rgba(227, 166, 85, 0.1);
}

.card:active {
  transform: scale(0.995);
}

.head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.type-tag {
  font-size: 20rpx;
  border-radius: 999rpx;
  padding: 6rpx 12rpx;
  font-weight: 700;
  color: #8C4A00;
  background: #FFE7A8;
  border: 1rpx solid #F2C35C;
}

.author {
  font-size: 20rpx;
  color: #A17A4C;
}

.title-row {
  margin-top: 10rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10rpx;
}

.name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #2F2A22;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-pending {
  color: #8A5A19;
  background: #FFF1CD;
  border: 1rpx solid #EFC679;
}

.status-done {
  color: #3F7E1F;
  background: #EAF6DD;
  border: 1rpx solid #95CC64;
}

.status-reject {
  color: #B55353;
  background: #FFE7E7;
  border: 1rpx solid #E48B8B;
}

.meta-row {
  margin-top: 10rpx;
}

.meta-left {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.meta-text {
  font-size: 20rpx;
  color: #8A642C;
  background: #FFF5E8;
  border: 1rpx solid #F1DEC1;
  border-radius: 999rpx;
  padding: 5rpx 10rpx;
}

.status-text {
  font-weight: 700;
}

.card-arrow-wrap {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #FFF4DC;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-arrow {
  font-size: 26rpx;
  color: #B9852F;
}

.desc {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #7E6343;
  line-height: 1.5;
  background: #FFFCF6;
  border-radius: 16rpx;
  padding: 10rpx 12rpx;
  border: 1rpx solid #F1E4CE;
}

.empty {
  text-align: center;
  color: #8A8378;
  font-size: 24rpx;
  padding: 34rpx 12rpx;
}
