.page {
  --page-bg: #F4F9F4;
  --card-bg: #FFFFFF;
  --primary: #549F77;
  --primary-soft: #D5ECDE;
  --text-main: #242926;
  --text-sub: #4A5650;
  --text-muted: #72867B;
  --divider: #E2EBE5;
  --warning: #F59E0B;
  min-height: 100vh;
  background: var(--page-bg);
  padding: 24rpx;
  box-sizing: border-box;
}

.tabs {
  display: flex;
  background: var(--card-bg);
  border: 1rpx solid var(--divider);
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 16rpx;
}

.tab {
  flex: 1;
  text-align: center;
  line-height: 64rpx;
  border-radius: 12rpx;
  color: var(--text-muted);
  font-size: 24rpx;
}

.tab.active {
  background: var(--primary-soft);
  color: var(--primary);
  font-weight: 600;
}

.card {
  background: var(--card-bg);
  border: 1rpx solid var(--divider);
  border-radius: 20rpx;
  padding: 18rpx;
  margin-bottom: 12rpx;
}

.head { display: flex; justify-content: space-between; align-items: center; }
.name { font-size: 28rpx; color: var(--text-main); font-weight: 600; }
.status { font-size: 22rpx; color: var(--warning); }
.price { display: block; margin-top: 8rpx; font-size: 30rpx; font-weight: 700; color: var(--text-main); }
.desc { display: block; margin-top: 8rpx; font-size: 22rpx; color: var(--text-sub); }
.empty { text-align: center; color: var(--text-muted); font-size: 24rpx; margin-top: 28rpx; }

@media (prefers-color-scheme: dark) {
  .page {
    --page-bg: #171F1B;
    --card-bg: #2C3832;
    --primary: #68BB8F;
    --primary-soft: #43745A;
    --text-main: #EEF4F1;
    --text-sub: #94A99C;
    --text-muted: #677C71;
    --divider: #3A4A43;
  }
}
