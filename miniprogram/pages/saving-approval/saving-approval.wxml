<view class="page">
  <view class="tabs card-shell">
    <view class="tab {{activeTab === 'created' ? 'active' : ''}}" data-tab="created" bindtap="switchTab">我发起的</view>
    <view class="tab {{activeTab === 'reviewed' ? 'active' : ''}}" data-tab="reviewed" bindtap="switchTab">我评估过的</view>
  </view>

  <view class="card" wx:for="{{currentList}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
    <view class="head">
      <view class="title-wrap">
        <text class="name">{{item.name}}</text>
      </view>
      <view class="card-arrow-wrap">
        <text class="card-arrow">›</text>
      </view>
    </view>
    <view class="meta-row">
      <view class="price-wrap">
        <text class="price-label">预算金额</text>
        <text class="price">¥{{item.price}}</text>
      </view>
      <text class="status-pill {{item.status === '已放弃' ? 'status-reject' : (item.status === '已出结果' ? 'status-done' : 'status-pending')}}">{{item.status}}</text>
    </view>
    <text class="desc">{{item.reason}}</text>
  </view>

  <view class="empty card-shell" wx:if="{{!currentList.length}}">暂无审批数据</view>
</view>
