<view class="page">
  <scroll-view class="page-scroll" scroll-y>
    <view class="hero card">
      <text class="hero-title">双十一满减精算器</text>
      <text class="hero-desc">支持多平台优惠叠加、合并/拆单对比、凑单建议与预算预警</text>
    </view>

    <view class="card section">
      <view class="section-head">
        <text class="section-title">① 平台模板</text>
      </view>
      <picker range="{{templateOptions}}" range-key="label" value="{{templateIndex}}" bindchange="onTemplateChange">
        <view class="picker">{{templateOptions[templateIndex].label}}（点击切换）</view>
      </picker>
    </view>

    <view class="card section">
      <view class="section-head">
        <text class="section-title">② 商品清单（{{goods.length}}）</text>
        <view class="section-action" bindtap="addGoods">+ 新增商品</view>
      </view>

      <block wx:for="{{goods}}" wx:key="id" wx:for-item="goodsItem">
        <view class="goods-item">
          <view class="item-head">
            <text class="item-title">商品{{index + 1}}</text>
            <text class="item-del" data-id="{{goodsItem.id}}" bindtap="removeGoods">删除</text>
          </view>

          <input class="input" placeholder="商品名称" value="{{goodsItem.name}}" data-id="{{goodsItem.id}}" data-field="name" bindinput="onGoodsInput" />
          <view class="row-2">
            <input class="input" placeholder="店铺" value="{{goodsItem.shop}}" data-id="{{goodsItem.id}}" data-field="shop" bindinput="onGoodsInput" />
            <input class="input" placeholder="品类" value="{{goodsItem.category}}" data-id="{{goodsItem.id}}" data-field="category" bindinput="onGoodsInput" />
          </view>

          <view class="row-3">
            <input class="input" type="digit" placeholder="活动价" value="{{goodsItem.price}}" data-id="{{goodsItem.id}}" data-field="price" bindinput="onGoodsInput" />
            <input class="input" type="number" placeholder="数量" value="{{goodsItem.qty}}" data-id="{{goodsItem.id}}" data-field="qty" bindinput="onGoodsInput" />
            <input class="input" type="digit" placeholder="运费" value="{{goodsItem.shipping}}" data-id="{{goodsItem.id}}" data-field="shipping" bindinput="onGoodsInput" />
          </view>

          <view class="switch-row">
            <view class="switch-item">
              <text class="switch-label">参与跨店</text>
              <switch checked="{{goodsItem.joinCross}}" data-id="{{goodsItem.id}}" data-field="joinCross" bindchange="onGoodsSwitch" color="#E6B34E" />
            </view>
            <view class="switch-item">
              <text class="switch-label">参与品类券</text>
              <switch checked="{{goodsItem.joinCategory}}" data-id="{{goodsItem.id}}" data-field="joinCategory" bindchange="onGoodsSwitch" color="#E6B34E" />
            </view>
            <view class="switch-item">
              <text class="switch-label">预售</text>
              <switch checked="{{goodsItem.usePresale}}" data-id="{{goodsItem.id}}" data-field="usePresale" bindchange="onGoodsSwitch" color="#E6B34E" />
            </view>
          </view>

          <view class="row-2" wx:if="{{goodsItem.usePresale}}">
            <input class="input" type="digit" placeholder="定金（单件）" value="{{goodsItem.deposit}}" data-id="{{goodsItem.id}}" data-field="deposit" bindinput="onGoodsInput" />
            <input class="input" type="digit" placeholder="膨胀后抵扣（单件）" value="{{goodsItem.inflateTo}}" data-id="{{goodsItem.id}}" data-field="inflateTo" bindinput="onGoodsInput" />
          </view>
        </view>
      </block>
    </view>

    <view class="card section">
      <view class="section-head">
        <text class="section-title">③ 优惠管理（{{coupons.length}}）</text>
        <view class="section-action" bindtap="addCoupon">+ 新增优惠</view>
      </view>

      <block wx:for="{{coupons}}" wx:key="id" wx:for-item="couponItem">
        <view class="coupon-item">
          <view class="item-head">
            <text class="item-title">优惠{{index + 1}}</text>
            <view class="head-right">
              <text class="enable-text">生效</text>
              <switch checked="{{couponItem.enabled}}" data-id="{{couponItem.id}}" bindchange="onCouponEnabledChange" color="#E6B34E" />
              <text class="item-del" data-id="{{couponItem.id}}" bindtap="removeCoupon">删除</text>
            </view>
          </view>

          <input class="input" placeholder="优惠名称" value="{{couponItem.name}}" data-id="{{couponItem.id}}" data-field="name" bindinput="onCouponInput" />

          <scroll-view class="type-scroll" scroll-x>
            <view class="type-list">
              <view
                class="type-chip {{couponItem.type === typeItem.key ? 'active' : ''}}"
                wx:for="{{couponTypeOptions}}"
                wx:key="key"
                wx:for-item="typeItem"
                data-id="{{couponItem.id}}"
                data-type="{{typeItem.key}}"
                bindtap="onCouponTypeTap"
              >
                {{typeItem.label}}
              </view>
            </view>
          </scroll-view>

          <input class="input" placeholder="互斥组（选填，例如 A）" value="{{couponItem.mutexGroup}}" data-id="{{couponItem.id}}" data-field="mutexGroup" bindinput="onCouponInput" />

          <block wx:if="{{couponItem.type === 'shop'}}">
            <view class="row-3">
              <input class="input" placeholder="店铺名" value="{{couponItem.shop}}" data-id="{{couponItem.id}}" data-field="shop" bindinput="onCouponInput" />
              <input class="input" type="digit" placeholder="门槛" value="{{couponItem.threshold}}" data-id="{{couponItem.id}}" data-field="threshold" bindinput="onCouponInput" />
              <input class="input" type="digit" placeholder="减免" value="{{couponItem.discount}}" data-id="{{couponItem.id}}" data-field="discount" bindinput="onCouponInput" />
            </view>
          </block>

          <block wx:if="{{couponItem.type === 'category'}}">
            <view class="row-3">
              <input class="input" placeholder="品类名" value="{{couponItem.category}}" data-id="{{couponItem.id}}" data-field="category" bindinput="onCouponInput" />
              <input class="input" type="digit" placeholder="门槛" value="{{couponItem.threshold}}" data-id="{{couponItem.id}}" data-field="threshold" bindinput="onCouponInput" />
              <input class="input" type="digit" placeholder="减免" value="{{couponItem.discount}}" data-id="{{couponItem.id}}" data-field="discount" bindinput="onCouponInput" />
            </view>
          </block>

          <block wx:if="{{couponItem.type === 'platform' || couponItem.type === 'redPacket' || couponItem.type === 'tradeIn' || couponItem.type === 'national'}}">
            <view class="row-3">
              <input class="input" type="digit" placeholder="门槛（可填0）" value="{{couponItem.threshold}}" data-id="{{couponItem.id}}" data-field="threshold" bindinput="onCouponInput" />
              <input class="input" type="digit" placeholder="减免" value="{{couponItem.discount}}" data-id="{{couponItem.id}}" data-field="discount" bindinput="onCouponInput" />
              <input class="input" type="digit" placeholder="上限（可填0）" value="{{couponItem.limit}}" data-id="{{couponItem.id}}" data-field="limit" bindinput="onCouponInput" />
            </view>
          </block>

          <block wx:if="{{couponItem.type === 'cross'}}">
            <view class="row-2">
              <input class="input" type="digit" placeholder="每满X" value="{{couponItem.everyFull}}" data-id="{{couponItem.id}}" data-field="everyFull" bindinput="onCouponInput" />
              <input class="input" type="digit" placeholder="减Y" value="{{couponItem.everyMinus}}" data-id="{{couponItem.id}}" data-field="everyMinus" bindinput="onCouponInput" />
            </view>
          </block>

          <block wx:if="{{couponItem.type === 'member'}}">
            <view class="row-2">
              <input class="input" type="digit" placeholder="折扣率（0.95=95折）" value="{{couponItem.rate}}" data-id="{{couponItem.id}}" data-field="rate" bindinput="onCouponInput" />
              <input class="input" type="digit" placeholder="门槛（可填0）" value="{{couponItem.threshold}}" data-id="{{couponItem.id}}" data-field="threshold" bindinput="onCouponInput" />
            </view>
          </block>
        </view>
      </block>
    </view>

    <view class="card section">
      <view class="section-head">
        <text class="section-title">④ 预算预警</text>
      </view>
      <input class="input" type="digit" placeholder="输入预算上限（可选）" value="{{budget}}" bindinput="onBudgetInput" />

      <button class="primary-btn" bindtap="calculate">开始精算</button>
    </view>

    <view class="card section" wx:if="{{result && result.ok}}">
      <view class="section-head">
        <text class="section-title">⑤ 计算结果</text>
        <text class="best-tip">推荐最优：{{result.bestFinalPayText}} 元</text>
      </view>

      <block wx:for="{{result.schemes}}" wx:key="key" wx:for-item="scheme">
        <view class="scheme-item">
          <view class="scheme-head">
            <text class="scheme-title">{{scheme.name}}</text>
            <text class="scheme-tag" wx:if="{{scheme.recommended}}">推荐最优</text>
          </view>

          <view class="summary-grid">
            <view class="summary-cell">
              <text class="k">商品基数</text>
              <text class="v">¥{{scheme.summary.goodsBaseText}}</text>
            </view>
            <view class="summary-cell">
              <text class="k">优惠总额</text>
              <text class="v highlight">-¥{{scheme.summary.discountTotalText}}</text>
            </view>
            <view class="summary-cell">
              <text class="k">尾款实付</text>
              <text class="v">¥{{scheme.summary.tailPayText}}</text>
            </view>
            <view class="summary-cell">
              <text class="k">运费</text>
              <text class="v">¥{{scheme.summary.shippingText}}</text>
            </view>
            <view class="summary-cell">
              <text class="k">定金</text>
              <text class="v">¥{{scheme.summary.depositText}}</text>
            </view>
            <view class="summary-cell">
              <text class="k">最终实付</text>
              <text class="v strong">¥{{scheme.summary.finalPayText}}</text>
            </view>
          </view>

          <view class="budget-warn" wx:if="{{scheme.budget.enabled && scheme.budget.overBudget}}">
            超预算 ¥{{scheme.budget.overBudgetText}}（预算 ¥{{scheme.budget.budgetText}}）
          </view>

          <view class="discount-line">
            店铺券 -¥{{scheme.summary.discountsText.shop}}｜品类券 -¥{{scheme.summary.discountsText.category}}｜平台券 -¥{{scheme.summary.discountsText.platform}}
          </view>
          <view class="discount-line">
            跨店满减 -¥{{scheme.summary.discountsText.cross}}｜会员折扣 -¥{{scheme.summary.discountsText.member}}｜红包 -¥{{scheme.summary.discountsText.redPacket}}
          </view>
          <view class="discount-line">
            以旧换新 -¥{{scheme.summary.discountsText.tradeIn}}｜国补 -¥{{scheme.summary.discountsText.national}}
          </view>

          <view class="sub-title">订单预览</view>
          <view class="order-row" wx:for="{{scheme.orderRows}}" wx:key="id" wx:for-item="orderItem">
            <text>{{orderItem.name}}</text>
            <text>¥{{orderItem.tailPayText}}</text>
          </view>

          <view class="sub-title">单品分摊</view>
          <view class="item-row" wx:for="{{scheme.itemRows}}" wx:key="id" wx:for-item="lineItem">
            <view>
              <text class="item-name">{{lineItem.name}} ×{{lineItem.qty}}</text>
              <text class="item-meta">原价¥{{lineItem.originalPayText}} / 实付¥{{lineItem.finalPayText}}</text>
            </view>
            <text class="item-save">省¥{{lineItem.savedText}}</text>
          </view>

          <view class="scheme-actions">
            <view class="log-btn" data-key="{{scheme.key}}" bindtap="toggleLogs">
              {{(scheme.key === 'merge' ? logOpenMap.merge : logOpenMap.split) ? '收起' : '查看'}}完整计算日志
            </view>
            <view class="sim-btn" data-key="{{scheme.key}}" bindtap="openReturnSimulation">模拟退货</view>
          </view>

          <view class="log-panel" wx:if="{{scheme.key === 'merge' ? logOpenMap.merge : logOpenMap.split}}">
            <view class="log-item" wx:for="{{scheme.logs}}" wx:key="*this" wx:for-item="logText">{{index + 1}}. {{logText}}</view>
          </view>
        </view>
      </block>
    </view>

    <view class="card section" wx:if="{{result && result.topUpSuggestion}}">
      <view class="section-head">
        <text class="section-title">⑥ 智能凑单建议</text>
      </view>
      <view class="topup-box {{'topup-' + result.topUpSuggestion.level}}">
        <text>当前有效参与满减金额：¥{{result.topUpSuggestion.currentAmountText}}</text>
        <text>距离下一档还差：¥{{result.topUpSuggestion.gapText}}</text>
        <text>预计可额外省：¥{{result.topUpSuggestion.saveText}}</text>
        <text>建议：{{result.topUpSuggestion.levelText}}</text>
      </view>
    </view>

    <view class="card section">
      <view class="section-head">
        <text class="section-title">⑦ 方案快照 & 对比</text>
      </view>

      <view class="row-2">
        <input class="input" placeholder="快照名称（选填）" value="{{snapshotName}}" bindinput="onSnapshotNameInput" />
        <button class="ghost-btn" bindtap="saveSnapshot">保存当前方案</button>
      </view>

      <button class="ghost-btn export-btn" bindtap="exportResultText">导出明细文本（复制到剪贴板）</button>

      <checkbox-group bindchange="onSnapshotSelectChange">
        <label class="snapshot-item" wx:for="{{snapshots}}" wx:key="id" wx:for-item="snapItem">
          <view class="snapshot-left">
            <checkbox value="{{snapItem.id}}" checked="{{snapItem.checked}}" color="#E6B34E" />
            <view class="snapshot-info">
              <text class="snapshot-title">{{snapItem.name}}</text>
              <text class="snapshot-meta">{{snapItem.createdAt}} ｜ 最优{{snapItem.bestSchemeName}} ｜ 实付¥{{snapItem.bestFinalPayText}}</text>
              <text class="snapshot-meta">合并¥{{snapItem.mergePayText}} / 拆单¥{{snapItem.splitPayText}} ｜ 商品{{snapItem.goodsCount}}个 优惠{{snapItem.couponCount}}个</text>
            </view>
          </view>
          <text class="item-del" data-id="{{snapItem.id}}" bindtap="deleteSnapshot">删除</text>
        </label>
      </checkbox-group>

      <view class="compare-box" wx:if="{{compareSummary}}">
        <text>已选{{compareSummary.selectedCount}}个方案</text>
        <text>最优：{{compareSummary.bestName}}（¥{{compareSummary.bestPayText}}）</text>
        <text>最贵：{{compareSummary.worstName}}（¥{{compareSummary.worstPayText}}）</text>
        <text>可节省差额：¥{{compareSummary.diffText}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="modal-mask" wx:if="{{showReturnPopup}}" catchtouchmove="noop">
    <view class="modal-dialog">
      <view class="modal-head">
        <text class="modal-title">退货模拟</text>
        <text class="modal-close" bindtap="closeReturnSimulation">关闭</text>
      </view>

      <text class="modal-subtitle">当前方案：{{returnSchemeName}}</text>

      <scroll-view class="modal-scroll" scroll-y>
        <view class="return-row" wx:for="{{returnRows}}" wx:key="id" wx:for-item="returnItem">
          <view class="return-main">
            <text class="return-name">{{returnItem.name}}</text>
            <text class="return-meta">可退{{returnItem.qty}}件，单件实付约 ¥{{returnItem.unitFinalText}}</text>
          </view>
          <view class="qty-control">
            <view class="qty-btn" data-id="{{returnItem.id}}" data-delta="-1" bindtap="adjustReturnQty">-</view>
            <input class="qty-input" type="number" value="{{returnItem.returnQty}}" data-id="{{returnItem.id}}" bindinput="onReturnQtyInput" />
            <view class="qty-btn" data-id="{{returnItem.id}}" data-delta="1" bindtap="adjustReturnQty">+</view>
          </view>
        </view>
      </scroll-view>

      <button class="primary-btn" bindtap="calculateReturnSimulation">模拟退货计算</button>

      <view class="return-result" wx:if="{{returnResult}}">
        <text>原下单实付：¥{{returnResult.originalPayText}}</text>
        <text>预计退款金额：¥{{returnResult.refundText}}</text>
        <text>退货后剩余花费：¥{{returnResult.remainCostText}}</text>
        <text>直接单独购买剩余商品：¥{{returnResult.directBuyText}}</text>
        <text>差额：¥{{returnResult.diffText}}</text>
        <text class="return-conclusion {{returnResult.isWorth ? 'worth' : 'not-worth'}}">{{returnResult.conclusion}}</text>
      </view>
    </view>
  </view>
</view>
