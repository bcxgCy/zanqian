.page {
  background: #FFF9F0;
  min-height: 100vh;
}

.page-scroll {
  height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 2rpx solid #F3E5CA;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.hero-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #3A2F1A;
}

.hero-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7C6D52;
  line-height: 1.5;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #3A2F1A;
}

.section-action {
  font-size: 22rpx;
  color: #B67A1F;
}

.input,
.picker {
  width: 100%;
  min-height: 72rpx;
  background: #FFF9F0;
  border: 2rpx solid #F0DFC1;
  border-radius: 16rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  font-size: 24rpx;
  color: #3A2F1A;
  margin-bottom: 12rpx;
}

.picker {
  display: flex;
  align-items: center;
}

.row-2,
.row-3 {
  display: grid;
  gap: 12rpx;
}

.row-2 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.row-3 {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.goods-item,
.coupon-item,
.scheme-item {
  border: 2rpx solid #F5EBD8;
  border-radius: 18rpx;
  padding: 16rpx;
  margin-bottom: 14rpx;
}

.item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.item-title {
  font-size: 24rpx;
  color: #5A3D0F;
  font-weight: 600;
}

.head-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.enable-text {
  font-size: 22rpx;
  color: #7D6A48;
}

.item-del {
  font-size: 22rpx;
  color: #D5675A;
  margin-left: 12rpx;
}

.switch-row {
  display: flex;
  gap: 12rpx;
  margin-top: 6rpx;
  margin-bottom: 6rpx;
}

.switch-item {
  flex: 1;
  background: #FFF9F0;
  border: 2rpx solid #F0DFC1;
  border-radius: 14rpx;
  padding: 10rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
}

.switch-label {
  font-size: 21rpx;
  color: #7D6A48;
}

.type-scroll {
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.type-list {
  display: flex;
  gap: 10rpx;
}

.type-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #FFF9F0;
  border: 2rpx solid #F0DFC1;
  color: #7D6A48;
  font-size: 22rpx;
  flex-shrink: 0;
}

.type-chip.active {
  background: #FCE9BE;
  border-color: #E6B34E;
  color: #7B4D08;
  font-weight: 600;
}

.primary-btn,
.ghost-btn {
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 16rpx;
  font-size: 25rpx;
  margin-top: 12rpx;
}

.primary-btn {
  color: #FFFFFF;
  background: linear-gradient(90deg, #E7B64F 0%, #D9962D 100%);
  border: 0;
}

.ghost-btn {
  margin-top: 0;
  color: #9A6314;
  background: #FFF6E4;
  border: 2rpx solid #F0DFC1;
}

.best-tip {
  font-size: 22rpx;
  color: #9A6314;
}

.scheme-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.scheme-title {
  font-size: 25rpx;
  color: #3A2F1A;
  font-weight: 600;
}

.scheme-tag {
  font-size: 20rpx;
  color: #8B5A08;
  background: #FCE7B6;
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.summary-cell {
  background: #FFF9F0;
  border-radius: 12rpx;
  border: 2rpx solid #F2E5CC;
  padding: 10rpx;
}

.summary-cell .k {
  display: block;
  font-size: 20rpx;
  color: #8E7C5D;
}

.summary-cell .v {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #3A2F1A;
  font-weight: 600;
}

.summary-cell .v.highlight {
  color: #C5682A;
}

.summary-cell .v.strong {
  color: #7C4600;
  font-size: 26rpx;
}

.discount-line {
  font-size: 20rpx;
  color: #7F7054;
  line-height: 1.6;
}

.budget-warn {
  margin-bottom: 8rpx;
  font-size: 21rpx;
  color: #D0493D;
  background: #FFF1EF;
  border: 2rpx solid #FFD6D1;
  border-radius: 10rpx;
  padding: 8rpx 10rpx;
}

.sub-title {
  margin-top: 10rpx;
  margin-bottom: 6rpx;
  font-size: 22rpx;
  color: #5C431D;
  font-weight: 600;
}

.order-row,
.item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
  border-bottom: 1rpx dashed #F0DFC1;
}

.item-row:last-child,
.order-row:last-child {
  border-bottom: none;
}

.item-name {
  display: block;
  font-size: 22rpx;
  color: #3A2F1A;
}

.item-meta {
  display: block;
  margin-top: 3rpx;
  font-size: 20rpx;
  color: #8E7C5D;
}

.item-save {
  font-size: 21rpx;
  color: #AD6116;
}

.log-btn {
  font-size: 22rpx;
  color: #8D5C12;
}

.scheme-actions {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.sim-btn {
  font-size: 22rpx;
  color: #A76012;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  border: 2rpx solid #F0D5A2;
  background: #FFF3DC;
}

.log-panel {
  margin-top: 8rpx;
  background: #FFF9F0;
  border: 2rpx solid #F0DFC1;
  border-radius: 12rpx;
  padding: 10rpx;
}

.log-item {
  font-size: 20rpx;
  color: #6E6048;
  line-height: 1.5;
  margin-bottom: 6rpx;
}

.log-item:last-child {
  margin-bottom: 0;
}

.topup-box {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  font-size: 22rpx;
  border-radius: 14rpx;
  padding: 12rpx;
  border: 2rpx solid #F0DFC1;
  background: #FFF9F0;
  color: #5E4D30;
}

.topup-green {
  background: #F3FBEA;
  border-color: #D8EFB6;
}

.topup-yellow {
  background: #FFF9E9;
  border-color: #F8E3A6;
}

.topup-red {
  background: #FFF1EF;
  border-color: #FFD2CB;
}

.export-btn {
  margin-top: 6rpx;
}

.snapshot-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx dashed #F0DFC1;
}

.snapshot-item:last-child {
  border-bottom: none;
}

.snapshot-left {
  display: flex;
  align-items: flex-start;
  min-width: 0;
  flex: 1;
}

.snapshot-info {
  margin-left: 10rpx;
  min-width: 0;
}

.snapshot-title {
  display: block;
  font-size: 24rpx;
  color: #3A2F1A;
  font-weight: 600;
}

.snapshot-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8E7C5D;
  line-height: 1.4;
}

.compare-box {
  margin-top: 12rpx;
  background: #FFF8E9;
  border: 2rpx solid #F2DDA9;
  border-radius: 12rpx;
  padding: 10rpx 12rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  font-size: 21rpx;
  color: #6B4D1E;
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 90;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-dialog {
  width: 100%;
  max-height: 86vh;
  background: #FFFFFF;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  box-sizing: border-box;
  padding: 22rpx;
  padding-bottom: calc(22rpx + env(safe-area-inset-bottom));
}

.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3A2F1A;
}

.modal-close {
  font-size: 24rpx;
  color: #A66019;
}

.modal-subtitle {
  display: block;
  margin-top: 8rpx;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: #7D6A48;
}

.modal-scroll {
  max-height: 48vh;
}

.return-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx dashed #F0DFC1;
}

.return-main {
  min-width: 0;
  flex: 1;
}

.return-name {
  display: block;
  font-size: 24rpx;
  color: #3A2F1A;
}

.return-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8E7C5D;
}

.qty-control {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.qty-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  border: 2rpx solid #E9D2A8;
  background: #FFF7E8;
  color: #7B5011;
  font-size: 30rpx;
  line-height: 40rpx;
  text-align: center;
}

.qty-input {
  width: 90rpx;
  height: 44rpx;
  border: 2rpx solid #F0DFC1;
  border-radius: 10rpx;
  background: #FFF9F0;
  text-align: center;
  font-size: 24rpx;
  color: #3A2F1A;
}

.return-result {
  margin-top: 14rpx;
  background: #FFF8EA;
  border: 2rpx solid #F1DCAE;
  border-radius: 12rpx;
  padding: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  font-size: 22rpx;
  color: #5A4728;
}

.return-conclusion {
  font-weight: 600;
}

.return-conclusion.worth {
  color: #2F7A2F;
}

.return-conclusion.not-worth {
  color: #C24A3A;
}
