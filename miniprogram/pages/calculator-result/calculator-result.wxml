<view class="page" wx:if="{{result}}">
  <view class="card summary-card">
    <text class="title helper-text">预计完成时间</text>
    <text class="date module-amount mint">{{result.endDate}}</text>
    <view class="info-row">
      <view class="info-item">
        <text class="num">{{result.periodCount}}</text>
        <text class="txt helper-text">总期数</text>
      </view>
      <view class="info-item">
        <text class="num module-amount">¥{{result.targetAmount}}</text>
        <text class="txt helper-text">目标金额</text>
      </view>
    </view>
  </view>

  <view class="card table-card">
    <view class="table-head" wx:if="{{!isMysteryPreset}}">
      <text class="col">期数</text>
      <text class="col">当期存入</text>
      <text class="col">累计存入</text>
      <text class="col">剩余待存</text>
    </view>
    <view class="table-head mystery" wx:if="{{isMysteryPreset}}">
      <text class="col">挑战日</text>
      <text class="col">神秘金额</text>
      <text class="col">进度</text>
      <text class="col">状态</text>
    </view>
    <scroll-view scroll-y class="table-body {{isMysteryPreset ? 'table-body-mystery' : ''}}">
      <view class="table-row {{index % 2 === 1 ? 'alt' : ''}}" wx:for="{{table}}" wx:key="index">
        <text class="col" wx:if="{{!isMysteryPreset}}">第{{item.index}}期</text>
        <text class="col" wx:if="{{isMysteryPreset}}">第{{item.index}}天</text>
        <text class="col" wx:if="{{!isMysteryPreset}}">¥{{item.expectedAmount}}</text>
        <text class="col" wx:if="{{!isMysteryPreset}}">¥{{item.cumulative}}</text>
        <text class="col" wx:if="{{!isMysteryPreset}}">¥{{item.remaining}}</text>
        <text class="col mystery-col" wx:if="{{isMysteryPreset}}">{{item.expectedText}}</text>
        <text class="col" wx:if="{{isMysteryPreset}}">{{item.progressText}}</text>
        <text class="col" wx:if="{{isMysteryPreset}}">{{item.unlockText}}</text>
      </view>
    </scroll-view>
  </view>

  <view class="bottom-actions">
    <button class="apply-btn btn-mint" bindtap="applyPlan">去设置为存钱计划</button>
    <button class="back-btn btn-ghost" bindtap="goBack">返回计算器</button>
  </view>
</view>
