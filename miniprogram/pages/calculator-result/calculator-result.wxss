.page {
  padding: var(--spacing);
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: var(--spacing);
  margin-bottom: var(--spacing);
  box-shadow: var(--shadow-card);
}

.summary-card {
  text-align: center;
}

.title {
  display: block;
  margin-bottom: 12rpx;
}

.date {
  display: block;
  margin-bottom: var(--spacing);
}

.info-row {
  display: flex;
  justify-content: space-around;
  padding-top: var(--spacing);
  border-top: 1rpx solid var(--color-border);
}

.info-item .num {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}

.info-item .txt {
  display: block;
  margin-top: 6rpx;
}

.table-head {
  display: flex;
  font-size: 24rpx;
  color: var(--color-text);
  font-weight: 500;
  padding: 16rpx 0;
  background: var(--color-primary-light);
  border-radius: var(--radius-btn) var(--radius-btn) 0 0;
  margin: calc(-1 * var(--spacing)) calc(-1 * var(--spacing)) 0;
  padding-left: var(--spacing);
  padding-right: var(--spacing);
}

.table-head.mystery {
  background: rgba(102, 126, 234, 0.16);
}

.table-row {
  display: flex;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.table-row.alt {
  background: var(--color-disabled-bg);
}

.col {
  flex: 1;
  text-align: center;
}

.table-body {
  max-height: 560rpx;
  margin-top: 8rpx;
}

.table-body-mystery {
  max-height: 620rpx;
}

.mystery-col {
  color: var(--color-primary);
}

.bottom-actions {
  position: fixed;
  left: var(--spacing);
  right: var(--spacing);
  bottom: calc(var(--spacing) + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.apply-btn {
  font-size: 28rpx;
  padding: 24rpx 0;
}

.back-btn {
  font-size: 26rpx;
  padding: 16rpx 0;
}
