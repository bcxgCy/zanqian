.page {
  background: #FFF9F0;
  min-height: 100vh;
  padding: var(--spacing);
  padding-bottom: calc(210rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border-radius: 40rpx;
  border: 2rpx solid #EEF4E3;
  padding: var(--spacing);
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(168, 216, 78, 0.12), 0 2rpx 8rpx rgba(255, 255, 255, 0.7);
}

.summary-card {
  text-align: center;
  background: linear-gradient(135deg, #E8F5D8 0%, #F0F8E6 50%, #EAF6DD 100%);
  border: 4rpx solid #FFFFFF;
}

.title {
  display: block;
  margin-bottom: 12rpx;
  color: #6E685E;
  font-size: 24rpx;
}

.date {
  display: block;
  margin-bottom: 20rpx;
  font-size: 54rpx;
  font-weight: 700;
  color: #2F2A22;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(143, 175, 102, 0.28);
}

.info-item {
  flex: 1;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 14rpx 8rpx;
}

.info-item .num {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #2F2A22;
}

.info-item .txt {
  display: block;
  margin-top: 6rpx;
  color: #8A8378;
}

.table-card {
  padding-top: 0;
  overflow: hidden;
  padding: 0;
}

.table-head {
  display: flex;
  font-size: 24rpx;
  color: #5E8F20;
  font-weight: 600;
  background: #F2F8E8;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #E6EED8;
}

.table-head.mystery {
  background: #F2F8E8;
  color: #5E8F20;
}

.table-row {
  display: flex;
  font-size: 24rpx;
  color: #6E685E;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #EEF2E6;
}

.table-row.alt {
  background: #FBFDF6;
}

.col {
  flex: 1;
  text-align: center;
}

.table-body {
  max-height: 560rpx;
}

.table-body-mystery {
  max-height: 620rpx;
}

.mystery-col {
  color: #6E685E;
  font-weight: 400;
}

.bottom-actions {
  position: fixed;
  left: var(--spacing);
  right: var(--spacing);
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.apply-btn,
.back-btn {
  width: 100%;
  margin: 0;
  border-radius: 40rpx;
  font-size: 28rpx;
  line-height: 1;
  padding: 24rpx 0;
  border: 0;
}

.apply-btn {
  color: #FFFFFF;
  background: #8FCF57;
  box-shadow: 0 8rpx 20rpx rgba(143, 207, 87, 0.22);
}

.back-btn {
  color: #5E8F20;
  background: #FFFFFF;
  border: 2rpx solid #B8D989;
  font-size: 26rpx;
  padding: 18rpx 0;
}
