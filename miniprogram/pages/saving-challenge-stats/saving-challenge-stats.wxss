.page {
  background: #FFF9F0;
  min-height: 100vh;
  padding: var(--spacing);
  box-sizing: border-box;
}

.card.hero-card {
  margin-bottom: 14rpx;
  background: linear-gradient(135deg, #79D149 0%, #A8D84E 100%);
  border: none;
  box-shadow: 0 10rpx 28rpx rgba(121, 209, 73, 0.28);
}

.hero-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

.card {
  background: #FFFFFF;
  border-radius: 40rpx;
  border: 2rpx solid #EEF4E3;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(168, 216, 78, 0.12), 0 2rpx 8rpx rgba(255, 255, 255, 0.7);
}

.summary-panel {
  margin-bottom: 16rpx;
  padding: 22rpx;
}

.summary-head {
  background: linear-gradient(135deg, #F7FBEA 0%, #EDF7D3 100%);
  border: 2rpx solid #E4EDCB;
  border-radius: 24rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 14rpx;
}

.summary-head-label {
  display: block;
  font-size: 22rpx;
  color: #6D6A57;
}

.summary-head-value {
  display: block;
  margin-top: 6rpx;
  font-size: 42rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #4D8C18;
}

.summary-grid {
  display: flex;
  flex-wrap: wrap;
  margin-right: -10rpx;
  margin-bottom: -10rpx;
}

.summary-group {
  padding-bottom: 14rpx;
  margin-bottom: 14rpx;
  border-bottom: 1rpx dashed #E8EED8;
}

.summary-group.no-bottom {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.summary-group-title {
  font-size: 22rpx;
  color: #6D6A57;
  font-weight: 600;
  margin-bottom: 10rpx;
  padding-left: 4rpx;
}

.summary-item {
  width: calc((100% - 30rpx) / 3);
  box-sizing: border-box;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
  text-align: center;
  padding: 14rpx 8rpx;
  background: #FAFDF2;
  border: 1rpx solid #ECF3DA;
  border-radius: 18rpx;
}

.summary-label {
  display: block;
  font-size: 20rpx;
  color: #8A8378;
}

.summary-num {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #2F2A22;
}

.chart-block {
  margin-bottom: 16rpx;
}

.block-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.block-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2F2A22;
}

.block-sub {
  font-size: 20rpx;
  color: #8A8378;
}

.calendar-block {
  margin-bottom: 16rpx;
}

.calendar-summary {
  display: flex;
  margin-bottom: 14rpx;
  flex-wrap: wrap;
  margin-right: -12rpx;
}

.calendar-stat {
  font-size: 20rpx;
  color: #5F594E;
  background: #F7FBEA;
  border: 1rpx solid #E4EDCB;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
  margin-right: 12rpx;
  margin-bottom: 10rpx;
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  margin-right: -8rpx;
}

.calendar-cell,
.legend-cell {
  width: calc((100% - 112rpx) / 14);
  height: 28rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
  border-radius: 8rpx;
  background: #EFF3E5;
}

.calendar-cell.level-0,
.legend-cell.level-0 {
  background: #EFF3E5;
}

.calendar-cell.level-1,
.legend-cell.level-1 {
  background: #DDECC3;
}

.calendar-cell.level-2,
.legend-cell.level-2 {
  background: #BFE38E;
}

.calendar-cell.level-3,
.legend-cell.level-3 {
  background: #91CE57;
}

.calendar-cell.level-4,
.legend-cell.level-4 {
  background: #5EA529;
}

.calendar-legend {
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.legend-cell {
  width: 18rpx;
  height: 18rpx;
  margin: 0 4rpx;
}

.legend-text {
  font-size: 20rpx;
  color: #8A8378;
  margin: 0 4rpx;
}

.rank-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F0E9DA;
}

.rank-row:last-child {
  border-bottom: none;
}

.rank-no {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #F6D27A;
  color: #8A5A19;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
}

.rank-main {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
}

.rank-name {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #2F2A22;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.rank-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8A8378;
}

.rank-amount {
  margin-left: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #5E8F20;
}

.month-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F0E9DA;
}

.month-row:last-child {
  border-bottom: none;
}

.month-key {
  width: 130rpx;
  font-size: 22rpx;
  color: #2F2A22;
}

.month-count {
  flex: 1;
  font-size: 20rpx;
  color: #8A8378;
}

.month-amount {
  font-size: 22rpx;
  font-weight: 700;
  color: #5E8F20;
}

.empty {
  text-align: center;
  padding: 30rpx 0;
  font-size: 22rpx;
  color: #9A9387;
}
