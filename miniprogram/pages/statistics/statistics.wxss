.page {
  padding: var(--spacing);
  min-height: 100vh;
}

.tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: var(--spacing);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  border-radius: var(--radius-btn);
  background: var(--color-card-white);
}

.tab.active {
  background: var(--color-primary);
  color: #fff;
}

.picker-bar {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: 16rpx var(--spacing);
  margin-bottom: var(--spacing);
  font-size: 26rpx;
  color: var(--color-text);
}

.summary-cards {
  display: flex;
  gap: 12rpx;
  margin-bottom: var(--spacing);
}

.summary-card {
  flex: 1;
  padding: 16rpx 12rpx;
  text-align: center;
  background: var(--color-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.summary-label {
  display: block;
  margin-bottom: 8rpx;
}

.summary-num {
  display: block;
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: var(--spacing);
  margin-bottom: var(--spacing);
  box-shadow: var(--shadow-card);
}

.chart-block {
  margin-bottom: var(--spacing);
}

.chart-title {
  margin-bottom: 16rpx;
}

.star-deco {
  font-size: 18rpx;
  color: var(--color-primary);
  margin-left: 4rpx;
}

.empty-chart {
  text-align: center;
  padding: 40rpx 0;
}

.ring-block {
  margin-bottom: 40rpx;
}
