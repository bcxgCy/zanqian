<view class="page">
  <view class="tabs">
    <view class="tab {{mode === 'month' ? 'active' : ''}}" data-mode="month" bindtap="switchMode">按月</view>
    <view class="tab {{mode === 'year' ? 'active' : ''}}" data-mode="year" bindtap="switchMode">按年</view>
  </view>

  <picker mode="selector" range="{{keyOptions}}" value="{{keyIndex}}" bindchange="onKeyChange">
    <view class="picker-bar helper-text">{{currentKey}} ▼</view>
  </picker>

  <view class="summary-cards">
    <view class="summary-card card">
      <text class="summary-label helper-text">累计存入</text>
      <text class="summary-num module-amount mint">¥{{summary.saved}}</text>
    </view>
    <view class="summary-card card">
      <text class="summary-label helper-text">目标剩余</text>
      <text class="summary-num module-amount peach">¥{{summary.remaining}}</text>
    </view>
    <view class="summary-card card">
      <text class="summary-label helper-text">日均存入</text>
      <text class="summary-num module-amount blue">¥{{summary.dailyAvg}}</text>
    </view>
  </view>

  <view class="card chart-block">
    <view class="chart-title section-title-text">每日存入统计</view>
    <chart-bar data="{{barData}}" height="{{200}}" color="#9ADFD6"></chart-bar>
    <view class="empty-chart helper-text" wx:if="{{!barData.length}}">暂无数据</view>
  </view>

  <view class="card chart-block">
    <view class="chart-title section-title-text">存款走势</view>
    <chart-line data="{{lineData}}" height="{{200}}" color="#C8E8FA"></chart-line>
    <view class="empty-chart helper-text" wx:if="{{!lineData.length}}">暂无数据</view>
  </view>

  <view class="card chart-block ring-block">
    <view class="chart-title section-title-text">计划占比 <text class="star-deco">✦</text></view>
    <chart-ring data="{{ringData}}" total="{{ringTotal}}" height="{{240}}"></chart-ring>
  </view>
</view>
