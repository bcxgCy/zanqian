<view class="page">
  <view class="tabs">
    <view class="tab {{mode === 'month' ? 'active' : ''}}" data-mode="month" bindtap="switchMode">按月</view>
    <view class="tab {{mode === 'year' ? 'active' : ''}}" data-mode="year" bindtap="switchMode">按年</view>
  </view>

  <picker mode="selector" range="{{keyOptions}}" value="{{keyIndex}}" bindchange="onKeyChange">
    <view class="picker-bar">{{currentKey}} ▼</view>
  </picker>

  <view class="card summary">
    <view class="summary-item">
      <text class="num green">¥{{summary.saved}}</text>
      <text class="txt">存入</text>
    </view>
    <view class="summary-item">
      <text class="num">¥{{summary.remaining}}</text>
      <text class="txt">目标剩余</text>
    </view>
    <view class="summary-item">
      <text class="num">¥{{summary.dailyAvg}}</text>
      <text class="txt">日均存入</text>
    </view>
  </view>

  <view class="card chart-block">
    <view class="chart-title">柱状图</view>
    <chart-bar data="{{barData}}" height="{{200}}"></chart-bar>
    <view class="empty-chart" wx:if="{{!barData.length}}">暂无数据</view>
  </view>

  <view class="card chart-block">
    <view class="chart-title">折线图</view>
    <chart-line data="{{lineData}}" height="{{200}}"></chart-line>
    <view class="empty-chart" wx:if="{{!lineData.length}}">暂无数据</view>
  </view>

  <view class="card chart-block">
    <view class="chart-title">圆环图</view>
    <chart-ring data="{{ringData}}" total="{{ringTotal}}" height="{{220}}"></chart-ring>
  </view>
</view>
