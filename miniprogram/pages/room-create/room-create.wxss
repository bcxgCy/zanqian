/* 创建房间页样式 */
page {
  background-color: #F7F8FA;
}

.page {
  min-height: 100vh;
  padding: 20rpx;
  padding-bottom: 40rpx;
}

/* 表单卡片 */
.form-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2129;
  display: block;
  margin-bottom: 16rpx;
}

.required {
  color: #F53F3F;
  margin-left: 4rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  background: #fff;
}

.form-input:focus {
  border-color: #165DFF;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #fff;
  line-height: 1.6;
}

.form-textarea:focus {
  border-color: #165DFF;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #C9CDD4;
  margin-top: 8rpx;
}

/* 选择器 */
.picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  padding: 0 24rpx;
  background: #fff;
}

.picker-value {
  font-size: 30rpx;
  color: #1D2129;
}

.picker-arrow {
  font-size: 28rpx;
  color: #C9CDD4;
}

/* 开关列表 */
.switch-list {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid #F2F3F5;
}

.switch-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F7F8FA;
}

.switch-item:last-child {
  border-bottom: none;
}

.switch-info {
  flex: 1;
  margin-right: 20rpx;
}

.switch-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1D2129;
  display: block;
  margin-bottom: 6rpx;
}

.switch-desc {
  font-size: 24rpx;
  color: #86909C;
  display: block;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #165DFF, #0E42D2);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  margin-bottom: 32rpx;
}

.submit-btn.disabled {
  background: #E5E6EB;
  color: #C9CDD4;
}

/* 提示信息 */
.tips {
  background: #F7F8FA;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
}

.tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2129;
  display: block;
  margin-bottom: 16rpx;
}

.tips-text {
  font-size: 24rpx;
  color: #86909C;
  line-height: 1.8;
  display: block;
}
