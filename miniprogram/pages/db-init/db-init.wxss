/* 数据库初始化工具页面样式 */
page {
  background-color: #F7F8FA;
  min-height: 100vh;
}

.page {
  padding: 20rpx;
  padding-bottom: 60rpx;
}

/* 头部 */
.header {
  text-align: center;
  padding: 40rpx 0 30rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1D2129;
  display: block;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #86909C;
  display: block;
}

/* 卡片通用 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* 状态卡片 */
.status-card {
  border-left: 8rpx solid #00B42A;
}

.status-header {
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F2F3F5;
}

.status-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #00B42A;
}

.collection-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.collection-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
}

.collection-item.missing {
  background: #FFF1F0;
  border: 1rpx solid #FFCCC7;
}

.col-icon {
  font-size: 36rpx;
  width: 50rpx;
  text-align: center;
}

.col-info {
  flex: 1;
  min-width: 0;
}

.col-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2129;
  display: block;
}

.col-desc {
  font-size: 22rpx;
  color: #86909C;
  display: block;
  margin-top: 4rpx;
}

.col-count {
  font-size: 24rpx;
  color: #165DFF;
  font-weight: 500;
  background: #E8F3FF;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* 操作区域 */
.actions {
  margin-bottom: 24rpx;
}

.btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  margin-bottom: 20rpx;
}

.btn[disabled] {
  opacity: 0.6;
}

.btn-primary {
  background: linear-gradient(135deg, #165DFF, #0E42D2);
  color: #fff;
}

.btn-secondary {
  height: 84rpx;
  line-height: 84rpx;
  background: #fff;
  color: #165DFF;
  border: 2rpx solid #165DFF;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-test {
  height: 84rpx;
  line-height: 84rpx;
  background: #FFF7E8;
  color: #FF7D00;
  border: 2rpx solid #FFD666;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-danger {
  height: 84rpx;
  line-height: 84rpx;
  background: #FFF1F0;
  color: #F53F3F;
  border: 2rpx solid #FFCCC7;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.btn-row .btn {
  flex: 1;
  margin-bottom: 0;
}

.divider {
  text-align: center;
  padding: 20rpx 0;
  position: relative;
  margin: 30rpx 0 20rpx;
}

.divider::before,
.divider::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 30%;
  height: 1rpx;
  background: #E5E6EB;
}

.divider::before { left: 0; }
.divider::after { right: 0; }

.divider text {
  font-size: 24rpx;
  color: #C9CDD4;
  background: #F7F8FA;
  padding: 0 20rpx;
  position: relative;
  z-index: 1;
}

/* 危险操作区 */
.danger-zone {
  background: #FFF1F0;
  border: 2rpx solid #FFCCC7;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 30rpx;
}

.danger-header {
  margin-bottom: 20rpx;
}

.danger-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #F53F3F;
}

.btn-danger-full {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #F53F3F;
  color: #fff;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

/* 结果卡片 */
.result-card {
  background: #F7F8FA;
  border: 1rpx solid #E5E6EB;
  border-radius: 16rpx;
  overflow: hidden;
}

.result-header {
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #E5E6EB;
}

.result-title {
  font-size: 28rpx;
  font-weight: 600;
}

.result-content {
  max-height: 400rpx;
  padding: 24rpx;
}

.result-text {
  font-size: 24rpx;
  color: #4E5969;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
  font-family: monospace;
}

/* 使用说明 */
.guide-card {
  background: linear-gradient(135deg, #E8F3FF, #F0F5FF);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 30rpx;
}

.guide-header {
  margin-bottom: 20rpx;
}

.guide-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #165DFF;
}

.guide-steps {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.step {
  font-size: 26rpx;
  color: #4E5969;
  line-height: 1.6;
}
