<view class="page">
  <view class="header">
    <text class="title">🗄️ 数据库初始化工具</text>
    <text class="subtitle">v2.0 - 检测 & 引导模式</text>
  </view>

  <!-- 当前状态 -->
  <view class="card status-card" wx:if="{{statusChecked}}">
    <view class="status-header">
      <text class="status-title {{dbReady ? '✅ 数据库已就绪' : '⚠️ 需要配置'}}">{{dbReady ? '✅ 数据库已就绪，可以使用房间功能！' : '⚠️ 需要先创建数据库集合'}}</text>
      <text class="status-sub">{{existCount || 0}}/{{totalCount || 5}} 个集合已就绪</text>
    </view>

    <!-- 集合列表 -->
    <view class="collection-list">
      <view class="collection-item {{item.exists ? 'exists' : 'missing'}}"
        wx:for="{{collectionsStatus}}"
        wx:key="name"
      >
        <view class="col-icon">{{item.exists ? '✅' : '❌'}}</view>
        <view class="col-info">
          <text class="col-name">{{item.name}}</text>
          <text class="col-desc">{{item.desc}}{{item.error ? ' - ' + item.error : ''}}</text>
        </view>
        <text class="col-count" wx:if="{{item.exists}}">{{item.count || 0}} 条</text>
      </view>
    </view>
  </view>

  <!-- 缺失集合引导（关键！） -->
  <view class="guide-card" wx:if="{{!dbReady && missingCollections.length > 0}}">
    <view class="guide-header warning">
      <text class="guide-title">⚠️ 需要先创建数据库集合</text>
    </view>

    <view class="guide-content">
      <text class="guide-text">微信云开发要求集合必须手动创建，请按以下步骤操作：</text>

      <view class="steps">
        <view class="step">
          <text class="step-num">1</text>
          <text class="step-text">点击工具栏「☁️ 云开发」按钮</text>
        </view>
        <view class="step">
          <text class="step-num">2</text>
          <text class="step-text">进入左侧「数据库」页面</text>
        </view>
        <view class="step">
          <text class="step-num">3</text>
          <text class="step-text">点击右上角「+」添加集合</text>
        </view>
      </view>

      <view class="collections-to-create">
        <text class="create-title">需要创建以下 {{missingCollections.length}} 个集合：</text>
        <view class="create-list"
          wx:for="{{missingCollections}}"
          wx:key="name"
        >
          <text class="create-item">• {{index + 1}}. {{name}} ({{desc}})</text>
        </view>
      </view>

      <view class="tips">
        <text class="tip">💡 每个集合创建时：</text>
        <text class="tip">   - 权限选择「所有用户可读，仅创建者可读写」</text>
        <text class="tip">   - 不需要添加字段，留空即可</text>
      </view>
    </view>

    <!-- 快捷跳转按钮 -->
    <button class="btn btn-primary" bindtap="openCloudConsole">
      🚀 打开云开发控制台
    </button>
  </view>

  <!-- 操作按钮 -->
  <view class="actions" wx:if="{{dbReady}}">
    <button
      class="btn btn-primary {{loading ? 'disabled' : ''}}"
      disabled="{{loading}}"
      bindtap="initAll"
    >
      {{loading ? '初始化中...' : '🔄 重新检测状态'}}
    </button>

    <view class="btn-row" wx:if="{{!loading}}">
      <button class="btn btn-test" bindtap="insertTestData">🧪 插入测试数据</button>
      <button class="btn btn-danger-small" bindtap="clearTestData">🗑️ 清理测试数据</button>
    </view>
  </view>

  <!-- 未就绪时的提示 -->
  <view class="not-ready-tip" wx:if="{{!dbReady && !statusChecked}}">
    <text>正在检测数据库状态...</text>
  </view>

  <!-- 结果显示 -->
  <view class="result-card" wx:if="{{lastResult && !dbReady}}">
    <view class="result-header">
      <text class="result-title {{lastResult.code === 0 ? 'ℹ️ 提示' : '❌ 错误'}}">{{lastResult.code === 0 ? lastResult.data?.message || '提示' : '操作失败'}}</text>
    </view>
    <scroll-view class="result-scroll" scroll-y="true" max-height="300rpx">
      <text class="result-text">{{resultText}}</text>
    </scroll-view>
  </view>

  <!-- 使用说明 -->
  <view class="guide-card normal">
    <view class="guide-header">
      <text class="guide-title">📖 使用说明</text>
    </view>
    <view class="guide-steps">
      <text class="step-item">1️⃣ 先完成上方集合创建（如果还没创建）</text>
      <text class="step-item">2️⃣ 创建完成后，此页面会自动变为「✅ 已就绪」状态</text>
      <text class="step-item">3️⃣ 点击「🔄 重新检测状态」确认</text>
      <text class="step-item">4️⃣ 可选：插入测试数据验证功能是否正常</text>
      <text class="step-item">5️⃣ 测试完成后，使用「清理测试数据」删除</text>
      <text class="step-item">6️⃣ 然后就可以正常使用房间功能了！</text>
    </view>
  </view>
</view>
