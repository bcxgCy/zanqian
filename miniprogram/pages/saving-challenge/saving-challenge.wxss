.page {
  min-height: 100vh;
  background: #FFF9F0;
  padding: var(--spacing);
  box-sizing: border-box;
}

.card-shell {
  background: #FFFFFF;
  border: 2rpx solid #EEF4E3;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(168, 216, 78, 0.12), 0 2rpx 8rpx rgba(255, 255, 255, 0.7);
}

.tabs {
  display: flex;
  padding: 10rpx;
  margin-bottom: 18rpx;
}

.tab {
  flex: 1;
  text-align: center;
  height: 66rpx;
  line-height: 66rpx;
  border-radius: 999rpx;
  color: #7A746A;
  font-size: 24rpx;
  font-weight: 500;
  background: #FFF9F0;
}

.tab.active {
  background: #E6B34E;
  color: #FFFFFF;
  font-weight: 700;
}

.card {
  background: #FFFFFF;
  border: 2rpx solid #EEF4E3;
  border-radius: 32rpx;
  padding: 18rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 6rpx 20rpx rgba(168, 216, 78, 0.08);
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.title {
  flex: 1;
  min-width: 0;
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #2F2A22;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow-wrap {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #FFF4DC;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow {
  font-size: 26rpx;
  color: #B9852F;
}

.meta-row {
  margin-top: 10rpx;
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.meta-chip {
  font-size: 21rpx;
  color: #8A5A19;
  background: #FFF2D5;
  border: 1rpx solid #F0C979;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

.amount-row {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #6E685E;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.amount-label {
  color: #9A9387;
}

.amount-value {
  margin: 0 6rpx;
  font-size: 30rpx;
  color: #2F2A22;
  font-weight: 800;
}

.amount-sep {
  margin: 0 6rpx;
  color: #B9AF9F;
}

.empty {
  text-align: center;
  color: #8A8378;
  font-size: 24rpx;
  padding: 34rpx 12rpx;
}
