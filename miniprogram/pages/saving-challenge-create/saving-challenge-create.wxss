.page {
  min-height: 100vh;
  background: #FFF9F0;
}

.content {
  height: calc(100vh - 132rpx - env(safe-area-inset-bottom));
  box-sizing: border-box;
  padding: 20rpx var(--spacing) 20rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 40rpx;
  border: 2rpx solid #EEF4E3;
  box-shadow: 0 8rpx 32rpx rgba(168, 216, 78, 0.12), 0 2rpx 8rpx rgba(255, 255, 255, 0.7);
  margin-bottom: 20rpx;
}

.hero {
  padding: 24rpx 26rpx;
  background: linear-gradient(135deg, #FFF1CF 0%, #FFF6DF 50%, #FFF9EB 100%);
  border: 4rpx solid #FFFFFF;
}

.hero-caption {
  display: block;
  font-size: 22rpx;
  color: #8A6A31;
}

.hero-title {
  display: block;
  margin-top: 6rpx;
  font-size: 38rpx;
  font-weight: 800;
  color: #2F2A22;
}

.hero-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #7E776B;
}

.form-card {
  padding: 20rpx;
}

.field {
  margin-bottom: 18rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 25rpx;
  color: #2F2A22;
  font-weight: 600;
}

.input,
.textarea,
.sheet-search {
  width: 100%;
  background: #FFF9F0;
  border-radius: 24rpx;
  border: 2rpx solid #E3ECD4;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  color: #2F2A22;
  height: 92rpx;
  line-height: 92rpx;
}

.textarea {
  height: 170rpx;
  min-height: 170rpx;
  max-height: 170rpx;
  line-height: 1.5;
  padding-top: 16rpx;
  padding-bottom: 16rpx;
  overflow-y: auto;
}

.input:focus,
.textarea:focus,
.sheet-search:focus {
  border-color: #E6B34E;
}

.input-placeholder,
.textarea-placeholder,
.sheet-search-placeholder {
  color: #A9A092;
}

.template-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.template-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid #E1D4B8;
  background: #FFF7E8;
  color: #8A5A19;
  font-size: 22rpx;
}

.template-chip.more {
  background: #FDF1D4;
  border-color: #E6B34E;
  font-weight: 700;
}

.day-options {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.day-item {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid #E3ECD4;
  background: #FFF9F0;
  color: #7A746A;
  font-size: 24rpx;
}

.day-item.active {
  color: #8A5A19;
  border-color: #F0C979;
  background: #FFF2D5;
  font-weight: 700;
}

.custom-input {
  margin-top: 12rpx;
}

.switch-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-field .label {
  margin-bottom: 0;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 10rpx 16rpx calc(10rpx + env(safe-area-inset-bottom));
  background: transparent;
}

.submit-btn {
  background: #E6B34E;
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 72rpx;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.36);
  z-index: 120;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  top: 30vh;
  background: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0;
  border-top: 2rpx solid #EEF4E3;
  padding: 0 var(--spacing) calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  z-index: 121;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  display: flex;
  flex-direction: column;
}

.sheet.show {
  transform: translateY(0);
}

.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 96rpx;
  padding-top: 16rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #EEE4D1;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2F2A22;
}

.sheet-close {
  font-size: 24rpx;
  color: #8A5A19;
}

.sheet-search-wrap {
  margin-top: 12rpx;
}

.sheet-scroll {
  flex: 1;
  margin-top: 12rpx;
  min-height: 0;
}

.group {
  margin-bottom: 16rpx;
}

.group-title {
  display: block;
  font-size: 22rpx;
  color: #8A8378;
  margin-bottom: 8rpx;
}

.tpl-item {
  background: #FFF9F0;
  border: 2rpx solid #E3ECD4;
  border-radius: 20rpx;
  padding: 14rpx;
  margin-bottom: 8rpx;
}

.tpl-name {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #2F2A22;
}

.tpl-amount {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #7D776C;
}

.sheet-empty {
  text-align: center;
  color: #8A8378;
  font-size: 24rpx;
  padding: 24rpx 0;
}
