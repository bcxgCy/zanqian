.page {
  padding: 24rpx;
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: 28rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--color-border);
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 24rpx;
}

.item {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.8;
  margin-bottom: 12rpx;
}
