.page {
  background: #FFF9F0;
  min-height: 100vh;
  padding: var(--spacing);
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.calc-page {
  position: relative;
}

.card {
  background: #FFFFFF;
  border-radius: 40rpx;
  border: 2rpx solid #EEF4E3;
  padding: var(--spacing);
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(168, 216, 78, 0.12), 0 2rpx 8rpx rgba(255, 255, 255, 0.7);
}

.mode-switch {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.mode-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 999rpx;
  border: 2rpx solid #DDE9C8;
  background: #FFF9F0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #6E685E;
  font-weight: 500;
}

.mode-btn-active {
  background: linear-gradient(90deg, #79D149 0%, #A8D84E 100%);
  border-color: #A8D84E;
  color: #FFFFFF;
}

.field {
  margin-bottom: var(--spacing);
}

.field:last-child {
  margin-bottom: 0;
}

.field.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.field.row .label {
  margin-bottom: 0;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #6E685E;
  line-height: 1.4;
}

.input,
.picker {
  background: #FFF9F0;
  border-radius: 24rpx;
  padding: 22rpx var(--spacing);
  font-size: 26rpx;
  color: #2F2A22;
  border: 2rpx solid #E3ECD4;
}

.input-row {
  display: flex;
  align-items: center;
}

.flex-input {
  flex: 1;
}

.input-icon {
  margin-left: 12rpx;
  font-size: 32rpx;
  opacity: 0.7;
}

.icon-scroll {
  white-space: nowrap;
}

.icon-list {
  display: flex;
  gap: 16rpx;
}

.icon-item {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: #FFF9F0;
  border: 2rpx solid #E3ECD4;
  flex-shrink: 0;
}

.icon-item.active {
  border-color: #A8D84E;
  box-shadow: 0 0 0 4rpx rgba(168, 216, 78, 0.2);
}

.custom-method-list {
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.custom-method-item {
  background: #FFF9F0;
  border: 2rpx solid #E3ECD4;
  border-radius: 24rpx;
  padding: 16rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.custom-method-item.active {
  border-color: #A8D84E;
  background: #F2F8E8;
}

.custom-method-texts {
  flex: 1;
  min-width: 0;
}

.custom-method-title {
  display: block;
  font-size: 25rpx;
  font-weight: 600;
  color: #2F2A22;
  line-height: 1.3;
}

.custom-method-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #8A8378;
  line-height: 1.4;
}

.custom-method-radio {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  border: 2rpx solid #C9D9AE;
  background: #FFFFFF;
  margin-left: 14rpx;
  box-sizing: border-box;
}

.custom-method-radio.active {
  border: 8rpx solid #8FCF57;
}

.inline-preset-grid {
  margin-top: 8rpx;
}

.gallery-item-active {
  border-color: #A8D84E;
  box-shadow: 0 0 0 4rpx rgba(168, 216, 78, 0.2);
}

.preset-extra-row {
  margin-top: 18rpx;
  margin-bottom: 0;
}


.preset-hint {
  padding: 12rpx 16rpx;
  background: #F2F8E8;
  border-radius: 20rpx;
  margin-bottom: var(--spacing);
  color: #5E8F20;
}

.freq-options {
  display: flex;
  gap: 12rpx;
}

.freq-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: #7A746A;
  background: #FFF9F0;
  border: 2rpx solid #E3ECD4;
  border-radius: 24rpx;
}

.freq-item.active {
  background: #F2F8E8;
  border-color: #A8D84E;
  color: #4E7F18;
  font-weight: 600;
}

.action-group {
  position: fixed;
  left: var(--spacing);
  right: var(--spacing);
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: block;
  z-index: 60;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  margin: 0;
  padding: 0;
  border-radius: 40rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
}

.calc-btn {
  color: #FFFFFF;
  border: 0;
  background: #8FCF57;
  box-shadow: 0 8rpx 20rpx rgba(143, 207, 87, 0.22);
}

.action-btn-icon {
  font-size: 30rpx;
  line-height: 1;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  background: var(--mask);
  z-index: 100;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  top: 50vh;
  background: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0;
  border-top: 2rpx solid #EEF4E3;
  padding: var(--spacing);
  box-sizing: border-box;
  overflow-y: auto;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.sheet.show {
  transform: translateY(0);
}

.detail-sheet {
  z-index: 102;
}

.sheet-title {
  margin-bottom: 16rpx;
}

.sheet-desc {
  line-height: 1.6;
  color: #7A746A;
}

.sheet-close {
  margin-top: var(--spacing);
  font-size: 28rpx;
}

.gallery-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.gallery-item {
  width: calc((100% - 32rpx) / 3);
  padding: 20rpx 12rpx;
  background: #FFF9F0;
  border: 2rpx solid #E3ECD4;
  border-radius: 24rpx;
  text-align: center;
  box-sizing: border-box;
}

.g-icon {
  display: block;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.g-name {
  display: block;
  font-size: 22rpx;
}
