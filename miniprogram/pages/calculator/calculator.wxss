.page {
  padding: var(--spacing);
  padding-bottom: calc(var(--spacing) + env(safe-area-inset-bottom));
}

.calc-page {
  position: relative;
}

.page-deco {
  position: absolute;
  top: -20rpx;
  right: 40rpx;
  font-size: 64rpx;
  opacity: 0.15;
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: var(--spacing);
  margin-bottom: var(--spacing);
  box-shadow: var(--shadow-card);
}

.field {
  margin-bottom: var(--spacing);
}

.field.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.field.row .label {
  margin-bottom: 0;
}

.label {
  display: block;
  margin-bottom: 12rpx;
}

.input, .picker {
  background: var(--color-card-white);
  border-radius: var(--radius-btn);
  padding: 20rpx var(--spacing);
  font-size: 26rpx;
  color: var(--color-text);
  border: 1rpx solid var(--color-border);
}

.input-row {
  display: flex;
  align-items: center;
}

.flex-input {
  flex: 1;
}

.input-icon {
  margin-left: 12rpx;
  font-size: 32rpx;
  opacity: 0.6;
}

.icon-scroll {
  white-space: nowrap;
}

.icon-list {
  display: flex;
  gap: 16rpx;
}

.icon-item {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: var(--color-card-white);
  border: 2rpx solid var(--color-border);
  flex-shrink: 0;
}

.icon-item.active {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 4rpx rgba(22, 93, 255, 0.16);
}

.mode-tabs {
  display: flex;
  margin-bottom: var(--spacing);
  background: var(--color-disabled-bg);
  border-radius: var(--radius-btn);
  padding: 6rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  border-radius: 10rpx;
}

.mode-tab.active {
  background: var(--color-card-white);
  color: var(--color-text);
  font-weight: 500;
}

.preset-hint {
  padding: 12rpx 16rpx;
  background: var(--color-primary-light);
  border-radius: var(--radius-btn);
  margin-bottom: var(--spacing);
}

.freq-options {
  display: flex;
  gap: 12rpx;
}

.freq-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  background: var(--color-card-white);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-btn);
}

.freq-item.active {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
  color: var(--color-text);
}

.action-group {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.action-btn {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  margin: 0;
  padding: 0;
  border-radius: var(--radius-btn);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 88rpx;
}

.gallery-btn {
  gap: 10rpx;
}

.action-btn-icon {
  font-size: 30rpx;
  line-height: 1;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  background: var(--mask);
  z-index: 100;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-card-white);
  border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
  padding: var(--spacing);
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.sheet.show {
  transform: translateY(0);
}

.detail-sheet {
  z-index: 102;
}

.sheet-title {
  margin-bottom: 16rpx;
}

.sheet-desc {
  line-height: 1.6;
}

.sheet-close {
  margin-top: var(--spacing);
  font-size: 28rpx;
}

.gallery-scroll {
  white-space: nowrap;
  margin-top: 16rpx;
}

.gallery-list {
  display: flex;
  gap: 16rpx;
  padding-bottom: 16rpx;
}

.gallery-item {
  width: 160rpx;
  padding: 20rpx 12rpx;
  background: var(--color-card);
  border-radius: var(--radius-item);
  text-align: center;
  flex-shrink: 0;
}

.g-icon {
  display: block;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.g-name {
  display: block;
  font-size: 22rpx;
}
