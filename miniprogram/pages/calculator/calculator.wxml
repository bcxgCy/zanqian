<view class="page">
  <view class="card">
    <view class="field">
      <text class="label">存钱目的</text>
      <input class="input" placeholder="可选" value="{{name}}" data-field="name" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">选择图标</text>
      <view class="icon-list">
        <text class="icon-item {{icon === item ? 'active' : ''}}" wx:for="{{icons}}" wx:key="*this" data-icon="{{item}}" bindtap="selectIcon">{{item}}</text>
      </view>
    </view>
    <view class="field">
      <text class="label">目标金额（元）</text>
      <input class="input" type="digit" value="{{targetAmount}}" data-field="targetAmount" bindinput="onInput" placeholder="请输入" />
    </view>
  </view>

  <view class="card">
    <view class="mode-tabs">
      <view class="mode-tab {{calcMode === 'preset' ? 'active' : ''}}" data-mode="preset" bindtap="switchCalcMode">预设方案</view>
      <view class="mode-tab {{calcMode === 'fixed' ? 'active' : ''}}" data-mode="fixed" bindtap="switchCalcMode">固定频次</view>
      <view class="mode-tab {{calcMode === 'deadline' ? 'active' : ''}}" data-mode="deadline" bindtap="switchCalcMode">按结束时间</view>
    </view>

    <block wx:if="{{calcMode === 'preset'}}">
      <view class="preset-grid">
        <view class="preset-icon-item" wx:for="{{presets}}" wx:key="id" data-id="{{item.id}}" bindtap="showPresetSheet">
          <text class="p-icon">{{item.icon}}</text>
          <text class="p-name">{{item.name}}</text>
        </view>
      </view>
      <view class="preset-item" wx:for="{{presets}}" wx:key="id">
        <view class="preset-head" data-id="{{item.id}}" bindtap="togglePreset">
          <text>{{item.name}}</text>
          <text class="preset-arrow">{{expandedPreset === item.id ? '▲' : '▼'}}</text>
        </view>
        <view class="preset-desc" wx:if="{{expandedPreset === item.id}}">{{item.description}}</view>
      </view>
    </block>

    <block wx:elif="{{calcMode === 'fixed'}}">
      <view class="field">
        <text class="label">每期金额</text>
        <input class="input" type="digit" value="{{customAmount}}" data-field="customAmount" bindinput="onInput" />
      </view>
      <view class="field">
        <text class="label">存入频次</text>
        <picker range="{{frequencyOptions}}" value="{{frequencyIndex}}" bindchange="onFrequencyChange">
          <view class="input picker">{{frequencyOptions[frequencyIndex]}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="label">开始时间</text>
        <picker mode="date" value="{{startDate}}" bindchange="onStartChange">
          <view class="input picker">{{startDate}}</view>
        </picker>
      </view>
    </block>

    <block wx:else>
      <view class="field">
        <text class="label">结束时间</text>
        <picker mode="date" value="{{endDate}}" bindchange="onEndChange">
          <view class="input picker">{{endDate || '选择日期'}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="label">存入频次</text>
        <picker range="{{frequencyOptions}}" value="{{frequencyIndex}}" bindchange="onFrequencyChange">
          <view class="input picker">{{frequencyOptions[frequencyIndex]}}</view>
        </picker>
      </view>
      <view class="field row">
        <text class="label">随机金额</text>
        <switch checked="{{randomAmount}}" bindchange="onRandomChange" color="#7ECDA3" />
      </view>
      <view class="field">
        <text class="label">开始时间</text>
        <picker mode="date" value="{{startDate}}" bindchange="onStartChange">
          <view class="input picker">{{startDate}}</view>
        </picker>
      </view>
    </block>
  </view>

  <button class="calc-btn" bindtap="calculate">计算</button>

  <view class="sheet-mask" wx:if="{{presetSheetShow}}" bindtap="closePresetSheet"></view>
  <view class="sheet {{presetSheetShow ? 'show' : ''}}">
    <view class="sheet-title">{{presetSheetContent.name}}</view>
    <text class="sheet-desc">{{presetSheetContent.description}}</text>
    <button class="sheet-close" bindtap="closePresetSheet">知道了</button>
  </view>
</view>
