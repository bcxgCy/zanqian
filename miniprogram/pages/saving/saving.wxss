.page {
  background: #FFF9F0;
  min-height: 100vh;
  padding: var(--spacing);
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border-radius: 40rpx;
  border: 2rpx solid #EEF4E3;
  box-shadow: 0 8rpx 32rpx rgba(168, 216, 78, 0.12), 0 2rpx 8rpx rgba(255, 255, 255, 0.7);
  margin-bottom: 20rpx;
}

.summary-card {
  background: linear-gradient(135deg, #FFF1CF 0%, #FFF6DF 50%, #FFF9EB 100%);
  border: 4rpx solid #FFFFFF;
  padding: 28rpx;
}

.summary-caption {
  display: block;
  font-size: 24rpx;
  color: #6E685E;
}

.summary-amount-row {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}

.summary-currency {
  font-size: 42rpx;
  color: #2F2A22;
  font-weight: 700;
  margin-right: 6rpx;
}

.summary-total {
  font-size: 64rpx;
  line-height: 1;
  color: #2F2A22;
  font-weight: 800;
}

.summary-grid {
  margin-top: 22rpx;
  display: flex;
  gap: 12rpx;
}

.summary-item {
  flex: 1;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 14rpx 12rpx;
}

.summary-item-label {
  display: block;
  font-size: 22rpx;
  color: #8A8378;
}

.summary-item-value {
  display: block;
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #2F2A22;
}

.summary-tags {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.summary-tag {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #8A5A19;
  background: #F6D27A;
}

.entry-row {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  padding: 16rpx;
}

.entry-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.entry-left {
  flex-shrink: 0;
}

.entry-right {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  justify-content: center;
  height: 100%;
}

.entry-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.approval-bg { background: rgba(248, 184, 52, 0.3); }
.challenge-bg { background: rgba(243, 177, 86, 0.3); }

.entry-icon {
  font-size: 32rpx;
}

.entry-icon-image {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  display: block;
}

.entry-title {
  display: block;
  margin-top: 0;
  font-size: 32rpx;
  font-weight: 700;
  color: #2F2A22;
}

.entry-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #7D776C;
}

.section {
  padding: 20rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #2F2A22;
}

.section-more {
  font-size: 22rpx;
  color: #A56A1E;
}

.two-col-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.approval-card,
.challenge-card {
  background: #FFF9F0;
  border-radius: 20rpx;
  padding: 14rpx;
  border: 2rpx solid #E6EED8;
}

.card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-main {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.item-texts {
  min-width: 0;
  flex: 1;
}

.item-icon-wrap {
  width: 42rpx;
  height: 42rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.approval-bg-small { background: rgba(248, 184, 52, 0.24); }
.challenge-bg-small { background: rgba(243, 177, 86, 0.24); }

.item-icon {
  font-size: 24rpx;
}

.card-arrow {
  font-size: 28rpx;
  color: #9A9387;
  margin-left: 8rpx;
}

.approval-name,
.challenge-name {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #2F2A22;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.approval-price {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6E685E;
}

.approval-meta,
.challenge-meta,
.challenge-right {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #8A8378;
}

.challenge-top {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.challenge-right {
  margin-top: 0;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.empty-block {
  padding: 24rpx 18rpx;
  border: 2rpx dashed #E8DEC9;
  border-radius: 24rpx;
  background: #FFFDF7;
  text-align: center;
}

.empty-plus-circle {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  margin: 0 auto;
  background: #FFF2D8;
  border: 2rpx solid #F0D4A2;
  position: relative;
  box-shadow: inset 0 2rpx 6rpx rgba(255, 255, 255, 0.65);
}

.empty-plus-h,
.empty-plus-v {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  background: #D0903D;
  border-radius: 999rpx;
}

.empty-plus-h {
  width: 34rpx;
  height: 6rpx;
}

.empty-plus-v {
  width: 6rpx;
  height: 34rpx;
}

.empty-title {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: #5E4727;
}

.empty-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #9A8A73;
}
