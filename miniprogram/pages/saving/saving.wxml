<view class="page">
  <view class="summary-card card">
    <text class="summary-caption">本周预估省钱总额</text>
    <view class="summary-amount-row">
      <text class="summary-currency">¥</text>
      <text class="summary-total">{{summary.totalSaved}}</text>
    </view>

    <view class="summary-grid">
      <view class="summary-item">
        <text class="summary-item-label">挑战已省</text>
        <text class="summary-item-value">¥{{summary.challengeSaved}}</text>
      </view>
      <view class="summary-item">
        <text class="summary-item-label">审批放弃</text>
        <text class="summary-item-value">¥{{summary.approvalSaved}}</text>
      </view>
    </view>

    <view class="summary-tags">
      <text class="summary-tag">进行中 {{summary.ongoingChallengeCount}} 项</text>
      <text class="summary-tag">待处理 {{summary.pendingApprovalCount}} 笔</text>
    </view>
  </view>

  <view class="entry-row card">
    <view class="entry-box" bindtap="goApprovalCreate">
      <view class="entry-left">
        <view class="entry-icon-wrap approval-bg">
          <image class="entry-icon-image" src="cloud://cloud1-d1g1g2urwd9ff5a66.636c-cloud1-d1g1g2urwd9ff5a66-1462912205/other/nav-shenpi.jpg" mode="aspectFill"></image>
        </view>
      </view>
      <view class="entry-right">
        <text class="entry-title">消费审批</text>
        <text class="entry-desc">冷静一下再决定</text>
      </view>
    </view>

    <view class="entry-box" bindtap="goChallengeCreate">
      <view class="entry-left">
        <view class="entry-icon-wrap challenge-bg">
          <image class="entry-icon-image" src="cloud://cloud1-d1g1g2urwd9ff5a66.636c-cloud1-d1g1g2urwd9ff5a66-1462912205/other/nav-tiaozhan.jpg" mode="aspectFill"></image>
        </view>
      </view>
      <view class="entry-right">
        <text class="entry-title">省钱挑战</text>
        <text class="entry-desc">连续打卡更容易坚持</text>
      </view>
    </view>
  </view>

  <view class="section card">
    <view class="section-head">
      <text class="section-title">我的审批</text>
      <text class="section-more" bindtap="goApprovalList">更多 ›</text>
    </view>
    <view class="two-col-list">
      <view class="approval-card" wx:for="{{ongoingApprovals}}" wx:key="id" data-id="{{item.id}}" bindtap="goApprovalDetail">
        <view class="card-row">
          <view class="item-main">
            <view class="item-icon-wrap approval-bg-small">
              <text class="item-icon">🧾</text>
            </view>
            <view class="item-texts">
              <text class="approval-name">{{item.itemName}}</text>
              <text class="approval-price">¥{{item.price}}</text>
            </view>
          </view>
          <text class="card-arrow">›</text>
        </view>
        <text class="approval-meta">{{item.statusText}} · 剩余{{item.remainingHours}}小时</text>
      </view>
    </view>
  </view>

  <view class="section card">
    <view class="section-head">
      <text class="section-title">我的挑战</text>
      <text class="section-more" bindtap="goChallengeList">更多 ›</text>
    </view>
    <view class="two-col-list">
      <view class="challenge-card" wx:for="{{ongoingChallenges}}" wx:key="id" data-id="{{item.id}}" bindtap="goChallengeDetail">
        <view class="card-row">
          <view class="challenge-top">
            <view class="item-icon-wrap challenge-bg-small">
              <text class="item-icon">🏆</text>
            </view>
            <text class="challenge-name">{{item.name}}</text>
          </view>
          <text class="challenge-right">剩余{{item.leftDays}}天</text>
        </view>
        <text class="challenge-meta">连续{{item.streakDays}}天未返</text>
      </view>
    </view>
  </view>
</view>
