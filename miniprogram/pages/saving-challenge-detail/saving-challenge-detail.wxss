.page {
  min-height: 100vh;
  background: #FFF9F0;
  padding: var(--spacing);
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border: 2rpx solid #EEF4E3;
  border-radius: 40rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(168, 216, 78, 0.12), 0 2rpx 8rpx rgba(255, 255, 255, 0.7);
}

.hero {
  background: linear-gradient(135deg, #FFF1CF 0%, #FFF6DF 50%, #FFF9EB 100%);
  border: 4rpx solid #FFFFFF;
}

.hero-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #2F2A22;
}

.hero-tags {
  margin-top: 10rpx;
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.hero-tag {
  font-size: 21rpx;
  color: #8A5A19;
  background: #FFF2D5;
  border: 1rpx solid #F0C979;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

.hero-amount-row {
  margin-top: 12rpx;
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.hero-amount-label {
  font-size: 22rpx;
  color: #8A8378;
}

.hero-amount {
  font-size: 48rpx;
  line-height: 1;
  font-weight: 800;
  color: #2F2A22;
}

.calendar-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.calendar-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2F2A22;
}

.month {
  font-size: 22rpx;
  color: #8A8378;
}

.legend {
  display: flex;
  gap: 16rpx;
  margin-bottom: 10rpx;
  flex-wrap: wrap;
}

.legend-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #6E685E;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  display: inline-block;
}

.dot.checked { background: #8FCF57; }
.dot.pending { background: #E6B34E; }
.dot.repair { background: #E6B34E; }

.week-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 8rpx;
}

.week-item {
  text-align: center;
  font-size: 22rpx;
  color: #9A9387;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.day-cell {
  height: 68rpx;
  border-radius: 14rpx;
  border: 1rpx solid #E7E0CF;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFBF2;
}

.day-cell.empty {
  border: none;
  background: transparent;
}

.day-num {
  font-size: 22rpx;
  color: #2F2A22;
  font-weight: 600;
}

.day-cell.status-checked {
  background: #E9F8D9;
  border-color: #8FCF57;
}

.day-cell.status-pending {
  background: #FFF8E8;
  border-color: #F0C979;
}

.day-cell.status-repair {
  background: #FFF2D5;
  border-color: #E6B34E;
}
