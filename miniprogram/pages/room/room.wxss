/* 房间列表页样式 */
page {
  background-color: #F7F8FA;
}

.page {
  min-height: 100vh;
  padding: 20rpx;
  padding-bottom: 140rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #86909C;
  margin-bottom: 60rpx;
  text-align: center;
  padding: 0 40rpx;
}

.empty-actions {
  display: flex;
  gap: 24rpx;
}

.btn-primary {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #165DFF, #0E42D2);
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.btn-secondary {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #fff;
  color: #165DFF;
  border-radius: 40rpx;
  font-size: 30rpx;
  border: 2rpx solid #165DFF;
}

/* 房间卡片 */
.room-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.room-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.room-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.room-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1D2129;
}

.room-code {
  font-size: 24rpx;
  color: #86909C;
  font-family: monospace;
}

.room-badge {
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.badge-owner {
  background: #FFF7E8;
  color: #FF7D00;
}

.badge-member {
  background: #E8F3FF;
  color: #165DFF;
}

.room-desc {
  font-size: 26rpx;
  color: #4E5969;
  line-height: 1.5;
  margin-bottom: 24rpx;
  padding: 16rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
}

/* 统计数据 */
.room-stats {
  display: flex;
  gap: 40rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid #F2F3F5;
  border-bottom: 1rpx solid #F2F3F5;
  margin-bottom: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #165DFF;
}

.stat-label {
  font-size: 22rpx;
  color: #86909C;
}

/* 个人状态 */
.my-status {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
}

.nickname {
  font-size: 28rpx;
  font-weight: 500;
  color: #1D2129;
}

.checkin-info {
  font-size: 24rpx;
  color: #4E5969;
}

/* 底部操作栏 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.btn-create {
  background: linear-gradient(135deg, #165DFF, #0E42D2);
  color: #fff;
}

.btn-join {
  background: #fff;
  color: #165DFF;
  border: 2rpx solid #165DFF;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  gap: 20rpx;
  color: #86909C;
  font-size: 28rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E5E6EB;
  border-top-color: #165DFF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
