<view class="page">
  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && (!myRooms || myRooms.length === 0)}}">
    <text class="empty-icon">🏠</text>
    <text class="empty-title">还没有加入任何房间</text>
    <text class="empty-desc">创建或加入房间，和朋友一起坚持存钱</text>

    <view class="empty-actions">
      <button class="btn-primary" bindtap="goCreateRoom">创建房间</button>
      <button class="btn-secondary" bindtap="goJoinRoom">加入房间</button>
    </view>
  </view>

  <!-- 房间列表 -->
  <view class="room-list" wx:if="{{myRooms && myRooms.length > 0}}">
    <view
      class="room-card"
      wx:for="{{myRooms}}"
      wx:key="_id"
      bindtap="goRoomDetail"
      data-room-id="{{item._id}}"
    >
      <!-- 房间头部 -->
      <view class="card-header">
        <view class="room-info">
          <text class="room-name">{{item.roomName}}</text>
          <text class="room-code">房间码: {{item.roomCode}}</text>
        </view>
        <view class="room-badge {{item.isOwner ? 'badge-owner' : 'badge-member'}}">
          {{item.isOwner ? '房主' : '成员'}}
        </view>
      </view>

      <!-- 房间简介 -->
      <view class="room-desc" wx:if="{{item.roomDesc}}">
        <text>{{item.roomDesc}}</text>
      </view>

      <!-- 统计数据 -->
      <view class="room-stats">
        <view class="stat-item">
          <text class="stat-num">{{item.memberCount || 0}}</text>
          <text class="stat-label">成员</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">{{item.todayCheckinCount || 0}}</text>
          <text class="stat-label">今日打卡</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">{{item.weekCheckinCount || 0}}</text>
          <text class="stat-label">本周打卡</text>
        </view>
      </view>

      <!-- 个人状态 -->
      <view class="my-status" wx:if="{{item.myStatus}}">
        <text class="nickname">{{item.myStatus.nickname}}</text>
        <text class="checkin-info">
          连续 {{item.myStatus.continueDay || 0}} 天 · 今日{{item.myStatus.isCheckedInToday ? '已✅' : '未❌'}}打卡
        </text>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-actions" wx:if="{{myRooms && myRooms.length > 0}}">
    <button class="action-btn btn-create" bindtap="goCreateRoom">＋ 创建房间</button>
    <button class="action-btn btn-join" bindtap="goJoinRoom">加入房间</button>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>
</view>
