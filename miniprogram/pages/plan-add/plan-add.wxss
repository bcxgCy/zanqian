.page {
  background: #FFF9F0;
  min-height: 100vh;
  padding: var(--spacing);
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border-radius: 40rpx;
  border: 2rpx solid #EEF4E3;
  padding: var(--spacing);
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(168, 216, 78, 0.12), 0 2rpx 8rpx rgba(255, 255, 255, 0.7);
}

.field {
  margin-bottom: var(--spacing);
}

.field:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #6E685E;
  line-height: 1.4;
}

.label-row .label {
  margin-bottom: 0;
}

.input,
.picker {
  background: #FFF9F0;
  border-radius: 24rpx;
  padding: 22rpx var(--spacing);
  font-size: 26rpx;
  color: #2F2A22;
  border: 2rpx solid #E3ECD4;
}

.input-row {
  display: flex;
  align-items: center;
}

.flex-input {
  flex: 1;
}

.input-icon {
  margin-left: 12rpx;
  font-size: 32rpx;
  opacity: 0.7;
}

.target-fixed-tip {
  display: block;
  margin-top: 10rpx;
  color: #8C867B;
}

.media-field {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding-bottom: 8rpx;
}

.avatar-merge-field {
  margin-bottom: 24rpx;
}

.avatar-main-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.avatar-layout-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.avatar-picker {
  width: 132rpx;
  flex-shrink: 0;
}

.avatar-picker .label,
.category-picker .label {
  margin-bottom: 12rpx;
}

.avatar-preview {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
}

.avatar-image,
.avatar-fallback {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 2rpx solid #DDE9C8;
  background: #FFF9F0;
}

.avatar-image {
  display: block;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.avatar-action {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #5E8F20;
  display: block;
  line-height: 1.3;
}

.avatar-actions {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.preset-avatar-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.preset-avatar-grid {
  height: 120rpx;
  display: grid;
  grid-auto-flow: column;
  grid-template-rows: repeat(2, 52rpx);
  grid-auto-columns: 52rpx;
  gap: 12rpx;
  align-content: start;
}

.preset-avatar-item {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  background: #FFF9F0;
  border: 2rpx solid #E3ECD4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #5F594E;
  box-sizing: border-box;
}

.preset-avatar-item.active {
  border-color: #A8D84E;
  box-shadow: 0 0 0 4rpx rgba(168, 216, 78, 0.2);
}

.preset-avatar-item.upload-item {
  width: 52rpx;
  height: 52rpx;
  background: #8FCF57;
  border-color: #8FCF57;
}

.upload-item-text {
  font-size: 14rpx;
  line-height: 1.15;
  color: #FFFFFF;
  text-align: center;
  white-space: pre-line;
}

.avatar-action-btn {
  height: 52rpx;
  border-radius: 999rpx;
  padding: 0 20rpx;
  display: inline-flex;
  align-items: center;
  font-size: 24rpx;
  color: #FFFFFF;
  background: #8FCF57;
  width: fit-content;
}

.avatar-action-btn.ghost {
  color: #5E8F20;
  background: #FFF9F0;
  border: 2rpx solid #DDE9C8;
}

.category-picker {
  flex: 1;
  min-width: 0;
}

.icon-scroll {
  white-space: nowrap;
}

.hide-original-icon-list {
  display: none;
}

.icon-list {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 0;
}

.icon-item {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: #FFF9F0;
  border: 2rpx solid #E3ECD4;
  flex-shrink: 0;
}

.icon-item.active {
  border-color: #A8D84E;
  box-shadow: 0 0 0 4rpx rgba(168, 216, 78, 0.2);
}

.panel {
  padding: 0;
  overflow: hidden;
}

.mode-switch {
  display: flex;
  gap: 16rpx;
  padding: 12rpx;
}

.mode-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 999rpx;
  border: 2rpx solid #DDE9C8;
  background: #FFF9F0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #6E685E;
  font-weight: 500;
}

.mode-btn-active {
  background: linear-gradient(90deg, #79D149 0%, #A8D84E 100%);
  border-color: #A8D84E;
  color: #FFFFFF;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx var(--spacing);
  color: #2F2A22;
  min-height: 76rpx;
  box-sizing: border-box;
}

.panel-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  line-height: 36rpx;
}

.mint-header {
  background: #F2F8E8;
}

.peach-header {
  background: #FFF3E4;
}

.panel-header.active {
  font-weight: 600;
}

.panel-arrow {
  color: #8C867B;
  font-size: 22rpx;
  line-height: 36rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.sub-panel {
  padding: 8rpx 0;
}

.sub-panel-split {
  border-top: 1rpx solid #EEF2E6;
}

.sub-panel-head {
  padding: 20rpx var(--spacing) 8rpx;
}

.sub-panel-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2F2A22;
  line-height: 1.4;
}

.sub-panel-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 300;
  color: #8C867B;
  line-height: 1.4;
}

.sub-panel .field {
  padding: 0 var(--spacing);
  margin-bottom: 20rpx;
}

.sub-panel .field:last-child {
  margin-bottom: 24rpx;
}

.label-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.label-hint {
  font-size: 22rpx;
  font-weight: 300;
  color: #9B958A;
  line-height: 1.4;
}

.preset-item {
  border-top: 1rpx solid #EEF2E6;
}

.preset-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  padding: 20rpx var(--spacing) var(--spacing);
}

.preset-grid-item {
  min-height: 148rpx;
  border-radius: 24rpx;
  background: #FFF9F0;
  border: 2rpx solid #E3ECD4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.preset-grid-item.selected {
  border-color: #A8D84E;
  box-shadow: 0 0 0 4rpx rgba(168, 216, 78, 0.2);
}

.preset-grid-icon {
  font-size: 38rpx;
  line-height: 1;
}

.preset-grid-name {
  font-size: 22rpx;
  color: #5F594E;
  text-align: center;
  line-height: 1.3;
}

.preset-head {
  display: flex;
  align-items: center;
  padding: 20rpx var(--spacing);
}

.preset-head.selected .preset-name {
  color: #5E8F20;
  font-weight: 600;
}

.preset-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.preset-name {
  flex: 1;
  font-size: 26rpx;
}

.preset-check {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.preset-arrow {
  color: #8C867B;
  font-size: 22rpx;
}

.preset-desc {
  padding: 0 var(--spacing) 20rpx 64rpx;
  line-height: 1.6;
  color: #7A746A;
}

.preset-mode {
  padding: 0 var(--spacing) 20rpx 64rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.preset-mode-label {
  flex: 1;
  line-height: 1.5;
}

.submit-btn {
  width: 100%;
  margin-top: 0;
  font-size: 28rpx;
  padding: 24rpx 0;
  border-radius: 40rpx;
  border: 0;
  color: #FFFFFF;
  background: #8FCF57;
  box-shadow: 0 8rpx 20rpx rgba(143, 207, 87, 0.22);
}

.submit-fixed-wrap {
  position: fixed;
  left: var(--spacing);
  right: var(--spacing);
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 60;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  background: var(--mask);
  z-index: 100;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  top: 70vh;
  background: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0;
  border-top: 2rpx solid #EEF4E3;
  padding: var(--spacing);
  padding-bottom: calc(var(--spacing) + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  overflow-y: auto;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  box-shadow: 0 -12rpx 36rpx rgba(55, 66, 20, 0.14);
}

.sheet.show {
  transform: translateY(0);
}

.sheet-title {
  margin-bottom: 16rpx;
}

.sheet-desc {
  line-height: 1.6;
  color: #7A746A;
}

.sheet-close {
  margin-top: var(--spacing);
  font-size: 28rpx;
}

.sheet-actions {
  margin-top: auto;
  padding-top: 20rpx;
  display: flex;
  gap: 16rpx;
}

.sheet-action-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
  padding: 0;
  border: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-action-secondary {
  background: #FFF9F0;
  border: 2rpx solid #DDE9C8;
  color: #6E685E;
}

.sheet-action-primary {
  background: linear-gradient(90deg, #79D149 0%, #A8D84E 100%);
  color: #FFFFFF;
}
