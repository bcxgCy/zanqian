.page {
  padding: 24rpx;
  padding-bottom: 120rpx;
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--color-border);
}

.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.input, .picker {
  background: var(--color-input-bg);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--color-text);
  border: 1rpx solid var(--color-border);
}

.icon-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.icon-item {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: var(--color-input-bg);
  border-radius: 16rpx;
  border: 1rpx solid var(--color-border);
}

.icon-item.active {
  background: var(--color-primary-light);
  border: 2rpx solid var(--color-primary);
}

.mode-tabs {
  display: flex;
  margin-bottom: 24rpx;
  background: var(--color-input-bg);
  border-radius: 16rpx;
  padding: 6rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  border-radius: 12rpx;
}

.mode-tab.active {
  background: var(--color-card);
  color: var(--color-primary-dark);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(126, 205, 163, 0.15);
}

.preset-item {
  border-bottom: 1rpx solid var(--color-border);
}

.preset-head {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.preset-head.selected .preset-name {
  color: var(--color-primary-dark);
  font-weight: 600;
}

.preset-check {
  color: var(--color-primary-dark);
  margin-right: 8rpx;
  font-size: 28rpx;
}

.preset-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.preset-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text);
}

.preset-arrow {
  color: var(--color-text-muted);
  font-size: 22rpx;
}

.preset-desc {
  padding: 0 0 20rpx 52rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.preset-tip {
  display: inline-block;
  color: var(--color-primary-dark);
  margin-top: 8rpx;
}

.submit-btn {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(135deg, #95d9b3, var(--color-primary)) !important;
  color: #fff !important;
  border-radius: var(--radius-btn);
  font-size: 30rpx;
  box-shadow: 0 8rpx 20rpx rgba(126, 205, 163, 0.25);
}

.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(74, 93, 82, 0.25);
  z-index: 100;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-card);
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.25s;
}

.sheet.show {
  transform: translateY(0);
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.sheet-desc {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.sheet-close {
  margin-top: 32rpx;
  background: linear-gradient(135deg, #95d9b3, var(--color-primary)) !important;
  color: #fff !important;
  border-radius: var(--radius-btn);
}
