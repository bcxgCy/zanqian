.page {
  padding: var(--spacing);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: var(--spacing);
  margin-bottom: var(--spacing);
  box-shadow: var(--shadow-card);
}

.field {
  margin-bottom: var(--spacing);
}

.field:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  margin-bottom: 12rpx;
}

.input, .picker {
  background: var(--color-input-bg);
  border-radius: var(--radius-btn);
  padding: 20rpx var(--spacing);
  font-size: 26rpx;
  color: var(--color-text);
  border: 1rpx solid var(--color-border);
}

.input-row {
  display: flex;
  align-items: center;
}

.flex-input {
  flex: 1;
}

.input-icon {
  margin-left: 12rpx;
  font-size: 32rpx;
  opacity: 0.6;
}

.icon-scroll {
  white-space: nowrap;
}

.icon-list {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 0;
}

.icon-item {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: var(--color-card-white);
  border: 2rpx solid var(--color-border);
  flex-shrink: 0;
}

.icon-item.active {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 4rpx rgba(22, 93, 255, 0.16);
}

.panel {
  padding: 0;
  overflow: hidden;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx var(--spacing);
  font-size: 28rpx;
  color: var(--color-text);
}

.mint-header {
  background: var(--color-primary-light);
}

.peach-header {
  background: rgba(212, 175, 55, 0.12);
}

.panel-header.active {
  font-weight: 500;
}

.panel-arrow {
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.sub-panel-title {
  padding: 16rpx var(--spacing) 0;
  font-size: 24rpx;
}

.preset-item {
  border-top: 1rpx solid var(--color-border);
}

.preset-head {
  display: flex;
  align-items: center;
  padding: 20rpx var(--spacing);
}

.preset-head.selected .preset-name {
  color: var(--color-primary);
  font-weight: 500;
}

.preset-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.preset-name {
  flex: 1;
  font-size: 26rpx;
}

.preset-check {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.preset-arrow {
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.preset-desc {
  padding: 0 var(--spacing) 20rpx 64rpx;
  line-height: 1.6;
}

.submit-btn {
  position: fixed;
  left: var(--spacing);
  right: var(--spacing);
  bottom: calc(var(--spacing) + env(safe-area-inset-bottom));
  font-size: 28rpx;
  padding: 24rpx 0;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  background: var(--mask);
  z-index: 100;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-card-white);
  border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
  padding: var(--spacing);
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.sheet.show {
  transform: translateY(0);
}

.sheet-title {
  margin-bottom: 16rpx;
}

.sheet-desc {
  line-height: 1.6;
}

.sheet-close {
  margin-top: var(--spacing);
  font-size: 28rpx;
}
