/* 房间详情页样式 */
page {
  background-color: #F7F8FA;
}

.page {
  min-height: 100vh;
  padding: 20rpx;
  padding-bottom: 180rpx;
}

/* ========== 顶部房间信息 ========== */
.room-header {
  background: linear-gradient(135deg, #165DFF, #0E42D2);
  border-radius: 24rpx;
  padding: 40rpx;
  color: #fff;
  margin-bottom: 24rpx;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.room-name {
  font-size: 40rpx;
  font-weight: 700;
  flex: 1;
}

.code-box {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
}

.code-text {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  font-family: monospace;
}

.copy-icon {
  font-size: 28rpx;
}

.room-desc {
  font-size: 26rpx;
  line-height: 1.6;
  opacity: 0.95;
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
}

.room-notice {
  font-size: 24rpx;
  line-height: 1.5;
  opacity: 0.9;
  margin-bottom: 24rpx;
  display: flex;
  gap: 8rpx;
  align-items: flex-start;
}

.notice-label {
  font-weight: 600;
  white-space: nowrap;
}

/* 数据概览 */
.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.85;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* ========== 个人状态卡 ========== */
.my-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.my-info {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.avatar-placeholder {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF9500, #FF5E00);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.info-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.nickname-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nickname {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
}

.edit-nickname-btn {
  font-size: 24rpx;
  color: #165DFF;
  background: none;
  border: none;
  padding: 0;
  line-height: 1;
}

.status-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #4E5969;
}

.continue-day {
  color: #165DFF;
  font-weight: 500;
}

.divider {
  color: #C9CDD4;
}

.checkin-status.checked {
  color: #00B42A;
}

.checkin-status.unchecked {
  color: #F53F3F;
}

/* 打卡按钮区域 */
.checkin-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.checkin-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #165DFF, #0E42D2);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.checkin-btn.disabled {
  background: #E5E6EB;
  color: #86909C;
}

.checkin-tip {
  font-size: 22rpx;
  color: #F53F3F;
}

/* 订阅提醒按钮 */
.subscribe-reminder-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #FFF7E8;
  color: #FF7D00;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 500;
  border: none;
  margin-top: 16rpx;
}

.subscribe-reminder-btn.subscribed {
  background: #E8FFEC;
  color: #00B42A;
}

/* 非成员提示 */
.join-tip {
  background: #FFF7E8;
  border-radius: 16rpx;
  padding: 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.join-tip text:first-child {
  font-size: 28rpx;
  color: #86909C;
}

.join-btn {
  width: 280rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, #FF7D00, #FF5E00);
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

/* ========== 榜单区域 ========== */
.ranking-section {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.tab-header {
  display: flex;
  border-bottom: 1rpx solid #F2F3F5;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #86909C;
  position: relative;
  transition: all 0.3s;
}

.tab-item.active {
  color: #165DFF;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 4rpx;
  background: #165DFF;
  border-radius: 2rpx;
}

/* 榜单列表 */
.ranking-list {
  padding: 16rpx 24rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F7F8FA;
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-item.is-me {
  background: #F2F9FF;
  margin: 0 -24rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  border-radius: 12rpx;
}

.rank-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.rank-badge.top-1 {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: #fff;
}

.rank-badge.top-2 {
  background: linear-gradient(135deg, #C0C0C0, #A0A0A0);
  color: #fff;
}

.rank-badge.top-3 {
  background: linear-gradient(135deg, #CD7F32, #B87333);
  color: #fff;
}

.rank-badge.normal {
  background: #F2F3F5;
  color: #86909C;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-nickname {
  font-size: 30rpx;
  font-weight: 500;
  color: #1D2129;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.score-info {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.main-score {
  font-size: 32rpx;
  font-weight: 700;
  color: #165DFF;
}

.sub-score {
  font-size: 22rpx;
  color: #86909C;
}

.empty-ranking,
.permission-denied {
  text-align: center;
  padding: 60rpx 0;
  color: #C9CDD4;
  font-size: 28rpx;
}

/* ========== 动态流 ========== */
.dynamics-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 24rpx;
}

.dynamics-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.dynamic-item {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.dynamic-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #722ED1, #531DAB);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.dynamic-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.dynamic-text {
  font-size: 28rpx;
  color: #1D2129;
  line-height: 1.5;
}

.dynamic-nickname {
  font-weight: 600;
  color: #165DFF;
}

.dynamic-time {
  font-size: 22rpx;
  color: #C9CDD4;
}

.empty-dynamics {
  text-align: center;
  padding: 40rpx 0;
  color: #C9CDD4;
  font-size: 26rpx;
}

/* ========== 房主操作栏 ========== */
.owner-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.owner-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  font-size: 28rpx;
  font-weight: 500;
  background: #F2F3F5;
  color: #4E5969;
  border: none;
}

.owner-btn.danger {
  background: #FFF1F0;
  color: #F53F3F;
}

/* ========== 弹窗样式 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.modal-mask.show {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  transform: scale(0.9);
  transition: transform 0.3s;
}

.modal-mask.show .modal-content {
  transform: scale(1);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F2F3F5;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
}

.modal-close {
  font-size: 36rpx;
  color: #C9CDD4;
  padding: 10rpx;
}

.modal-body {
  padding: 32rpx;
}

.nickname-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.nickname-input:focus {
  border-color: #165DFF;
}

.input-hint {
  font-size: 24rpx;
  color: #86909C;
  margin-top: 12rpx;
  display: block;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #F2F3F5;
}

.btn-cancel,
.btn-confirm {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  font-size: 28rpx;
  border: none;
}

.btn-cancel {
  background: #F2F3F5;
  color: #4E5969;
}

.btn-confirm {
  background: linear-gradient(135deg, #165DFF, #0E42D2);
  color: #fff;
}

/* ========== 加载状态 ========== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 300rpx;
  gap: 20rpx;
  color: #86909C;
  font-size: 28rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E5E6EB;
  border-top-color: #165DFF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
