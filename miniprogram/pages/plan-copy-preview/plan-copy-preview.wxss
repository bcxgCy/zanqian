.page {
  padding: var(--spacing);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  background: #f5f7fa;
}

/* 加载状态 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  color: #999;
  font-size: 28rpx;
}

/* 失效提示 */
.expired {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  padding: 40rpx;
}

.expired-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.expired-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.expired-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.expired-tip {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
  max-width: 500rpx;
}

/* 顶部提示 */
.header-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
  background: #e8f4fd;
  border-radius: 8rpx;
}

.tip-icon {
  font-size: 28rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #1890ff;
}

/* 快照卡片 */
.snapshot-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
  margin-bottom: 24rpx;
}

.snapshot-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.snapshot-icon {
  width: 80rpx;
  height: 80rpx;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f7fa;
  border-radius: 16rpx;
}

.snapshot-info {
  flex: 1;
}

.snapshot-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.snapshot-type {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.snapshot-amount {
  text-align: center;
  padding: 24rpx 0;
  margin-bottom: 20rpx;
}

.amount-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.amount-value {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #667eea;
}

.snapshot-meta {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 24rpx;
  color: #666;
}

/* 存钱规则 */
.snapshot-rule {
  background: #fafafa;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-top: 16rpx;
}

.rule-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.rule-desc {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* 复制说明 */
.copy-notice {
  background: #fffbe6;
  border: 1rpx solid #ffe58f;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.notice-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #d48806;
  margin-bottom: 12rpx;
}

.notice-content {
  font-size: 24rpx;
  color: #ad6800;
  line-height: 1.6;
}

.notice-content text {
  display: block;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  border-radius: 44rpx;
  text-align: center;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
}

.primary-btn {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff !important;
  border: none !important;
  font-weight: 500;
}

.primary-btn:active {
  opacity: 0.9;
}

.secondary-btn {
  background: #f5f5f5;
  color: #333 !important;
  border: none !important;
  font-weight: 400;
}

.secondary-btn:active {
  background: #eee;
}

/* 底部提示 */
.footer-tip {
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  padding: 20rpx 0;
}
