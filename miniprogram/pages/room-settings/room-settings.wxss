/* 房间设置页样式 */
page {
  background-color: #F7F8FA;
}

.page {
  min-height: 100vh;
  padding: 20rpx;
  padding-bottom: 180rpx;
}

/* 分区 */
.section {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F2F3F5;
}

.danger-zone .section-title {
  color: #F53F3F;
  border-bottom-color: #FFECE8;
}

/* 表单项 */
.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #4E5969;
  display: block;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 84rpx;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #fff;
}

.form-input:focus {
  border-color: #165DFF;
}

.form-textarea {
  width: 100%;
  min-height: 140rpx;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #fff;
  line-height: 1.6;
}

.form-textarea:focus {
  border-color: #165DFF;
}

/* 开关项 */
.switch-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F7F8FA;
}

.switch-item:last-child {
  border-bottom: none;
}

.switch-info {
  flex: 1;
  margin-right: 20rpx;
}

.switch-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1D2129;
  display: block;
  margin-bottom: 6rpx;
}

.switch-desc {
  font-size: 24rpx;
  color: #86909C;
  display: block;
}

/* 选择器项 */
.picker-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.picker-info {
  flex: 1;
}

.picker-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #1D2129;
  display: block;
  margin-bottom: 6rpx;
}

.picker-desc {
  font-size: 24rpx;
  color: #86909C;
  display: block;
}

.picker-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.picker-value {
  font-size: 28rpx;
  color: #165DFF;
  font-weight: 500;
}

.picker-arrow {
  font-size: 26rpx;
  color: #C9CDD4;
}

/* 邀请凭证 */
.invite-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.invite-desc {
  font-size: 26rpx;
  color: #86909C;
  line-height: 1.6;
}

.generate-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  background: #F7F8FA;
  color: #165DFF;
  border: 2rpx dashed #165DFF;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.generate-btn[disabled] {
  opacity: 0.6;
}

.token-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 16rpx;
}

.token-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
}

.token-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
}

.token-code {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  font-family: monospace;
  color: #1D2129;
}

.token-status {
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  display: inline-block;
  width: fit-content;
}

.token-status.active {
  background: #E8F3FF;
  color: #165DFF;
}

.token-status.used {
  background: #F2F3F5;
  color: #C9CDD4;
}

.token-time {
  font-size: 22rpx;
  color: #C9CDD4;
}

.copy-token-btn {
  width: 120rpx;
  height: 60rpx;
  line-height: 60rpx;
  background: #165DFF;
  color: #fff;
  border-radius: 8rpx;
  font-size: 24rpx;
  border: none;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 菜单列表 */
.menu-list {
  border-radius: 12rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 20rpx;
  background: #F7F8FA;
  border-bottom: 1rpx solid #fff;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item.danger .menu-text {
  color: #F53F3F;
}

.menu-text {
  font-size: 28rpx;
  color: #1D2129;
}

.menu-arrow {
  font-size: 28rpx;
  color: #C9CDD4;
}

/* 底部保存栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.save-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #165DFF, #0E42D2);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.save-btn[disabled] {
  background: #E5E6EB;
  color: #C9CDD4;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 300rpx;
  gap: 20rpx;
  color: #86909C;
  font-size: 28rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E5E6EB;
  border-top-color: #165DFF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
