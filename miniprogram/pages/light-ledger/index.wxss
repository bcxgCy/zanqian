.page {
  min-height: 100vh;
  background: #FFF7F5;
  padding: var(--spacing);
  box-sizing: border-box;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.card-shell {
  background: #FFFFFF;
  border: 2rpx solid #F6E2E6;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(219, 155, 171, 0.14), 0 2rpx 8rpx rgba(255, 255, 255, 0.75);
}

.toolbar {
  padding: 16rpx 24rpx;
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.picker-box {
  flex: 1;
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 999rpx;
  background: #FFF2F5;
  border: 2rpx solid #F4D9DF;
  color: #8B5A68;
  font-size: 24rpx;
  text-align: center;
  padding: 0 24rpx;
}

.picker-box.month {
  flex: 0 0 240rpx;
}

.summary {
  padding: 20rpx;
  display: flex;
  gap: 10rpx;
  margin-bottom: 16rpx;
  background: linear-gradient(135deg, #FFEFF3 0%, #FFF5F7 55%, #FFFDFC 100%);
  border: 4rpx solid #FFFFFF;
}

.summary-item {
  flex: 1;
  border-radius: 24rpx;
  background: #FFFFFF;
  padding: 14rpx 10rpx;
  text-align: center;
  border: 1rpx solid #F6E8EB;
}

.summary-label {
  display: block;
  font-size: 22rpx;
  color: #8E7580;
}

.summary-value {
  display: block;
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #4A3B42;
}

.summary-item.income .summary-value { color: #5D8B6A; }
.summary-item.expense .summary-value { color: #D36884; }
.summary-item.balance .summary-value { color: #BD5F78; }

.chart-card {
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #4A3B42;
}

.section-sub {
  font-size: 22rpx;
  color: #9B7F88;
}

.section-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.chart-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
}

.chart-main {
  flex: 1;
}

.chart-name {
  display: block;
  font-size: 22rpx;
  color: #6B5960;
  margin-bottom: 4rpx;
}

.chart-track {
  height: 12rpx;
  border-radius: 999rpx;
  background: #FBE6EB;
  overflow: hidden;
}

.chart-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #F2A3B7 0%, #E57E99 100%);
}

.chart-amount {
  font-size: 20rpx;
  color: #9B7F88;
}

.list-card {
  padding: 20rpx;
}

.date-title {
  display: block;
  margin-top: 12rpx;
  margin-bottom: 6rpx;
  font-size: 22rpx;
  color: #9B7F88;
}

.bill-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx dashed #F5DDE4;
}

.bill-row:last-child {
  border-bottom: none;
}

.bill-main {
  flex: 1;
  min-width: 0;
}

.bill-category {
  display: block;
  font-size: 25rpx;
  font-weight: 700;
  color: #4A3B42;
}

.bill-remark {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #9B7F88;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.book-tag {
  color: #B8647D;
  margin-left: 8rpx;
}

.bill-right {
  text-align: right;
}

.bill-amount {
  display: block;
  font-size: 26rpx;
  font-weight: 800;
}

.bill-amount.expense { color: #D26783; }
.bill-amount.income { color: #5D8B6A; }

.bill-tag.non {
  display: inline-block;
  margin-top: 6rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  color: #A55D73;
  background: #FFEAF0;
}

.empty-card {
  padding: 42rpx 20rpx;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  color: #4A3B42;
  font-weight: 700;
}

.empty-desc,
.empty {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9B7F88;
  text-align: center;
}

.bottom-actions {
  margin-top: 8rpx;
  display: flex;
  gap: 12rpx;
}

.bottom-btn {
  flex: 1;
  height: 74rpx;
  line-height: 74rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #FFF2F5;
  border: 2rpx solid #F4D9DF;
  color: #8B5A68;
  font-size: 24rpx;
}

.fab {
  position: fixed;
  right: 36rpx;
  bottom: calc(36rpx + env(safe-area-inset-bottom));
  min-width: 184rpx;
  height: 86rpx;
  line-height: 86rpx;
  text-align: center;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #E986A1 0%, #DB7290 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 24rpx rgba(219, 114, 144, 0.32);
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(70, 43, 52, 0.32);
  z-index: 120;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 121;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 0 var(--spacing) calc(20rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform .25s;
}

.sheet.show {
  transform: translateY(0);
}

.sheet-head {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #F5DDE4;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A3B42;
}

.sheet-close {
  font-size: 24rpx;
  color: #8B5A68;
}

.field {
  margin-top: 12rpx;
}

.label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 23rpx;
  color: #6D5860;
}

.input {
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 18rpx;
  border: 2rpx solid #F4D9DF;
  background: #FFF8FA;
  padding: 0 16rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  color: #4A3B42;
}

.type-row {
  margin-top: 12rpx;
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.type-chip,
.chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  border: 2rpx solid #F4D9DF;
  color: #8B5A68;
  font-size: 22rpx;
  background: #FFF2F5;
}

.type-chip.active,
.chip.active {
  background: #E986A1;
  border-color: #E986A1;
  color: #fff;
}

.chip-wrap {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
}

.chip-icon {
  font-size: 20rpx;
  line-height: 1;
}

.submit-btn {
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #E986A1 0%, #DB7290 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 76rpx;
}

.detail {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 121;
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx;
}

.detail-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #4A3B42;
  margin-bottom: 8rpx;
}

.detail-line {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #7D6770;
}

.detail-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 10rpx;
}

.detail-btn {
  flex: 1;
  text-align: center;
  height: 66rpx;
  line-height: 66rpx;
  border-radius: 999rpx;
  background: #FFF2F5;
  color: #8B5A68;
}

.detail-btn.danger {
  background: #FFE8EE;
  color: #C75775;
}
