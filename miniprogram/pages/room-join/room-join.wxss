/* 加入房间页样式 */
page {
  background-color: #F7F8FA;
}

.page {
  min-height: 100vh;
  padding: 20rpx;
  padding-bottom: 40rpx;
}

/* Tab 切换 */
.tab-header {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #86909C;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background: #165DFF;
  color: #fff;
  font-weight: 500;
}

/* 表单卡片 */
.form-card,
.nickname-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2129;
  display: block;
  margin-bottom: 16rpx;
}

.required {
  color: #F53F3F;
  margin-left: 4rpx;
}

/* 房间码/凭证输入 */
.code-input-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.code-input {
  flex: 1;
  height: 96rpx;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  padding: 0 32rpx;
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  text-align: center;
  font-family: monospace;
  box-sizing: border-box;
}

.code-input:focus {
  border-color: #165DFF;
}

.paste-btn {
  width: 140rpx;
  height: 96rpx;
  line-height: 96rpx;
  background: #F2F3F5;
  color: #4E5969;
  border-radius: 12rpx;
  font-size: 26rpx;
  border: none;
  flex-shrink: 0;
}

.input-hint {
  display: block;
  font-size: 22rpx;
  color: #C9CDD4;
  margin-top: 12rpx;
}

.input-error {
  display: block;
  font-size: 24rpx;
  color: #F53F3F;
  margin-top: 12rpx;
}

/* 搜索结果 */
.search-result {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F2F3F5;
}

.room-preview {
  background: #F7F8FA;
  border-radius: 16rpx;
  padding: 24rpx;
}

.preview-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
  display: block;
  margin-bottom: 10rpx;
}

.preview-desc {
  font-size: 26rpx;
  color: #4E5969;
  line-height: 1.5;
  display: block;
  margin-bottom: 16rpx;
}

.preview-meta {
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
  color: #86909C;
}

.preview-notice {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #FF7D00;
  padding: 12rpx 16rpx;
  background: #FFF7E8;
  border-radius: 8rpx;
}

/* 已是成员提示 */
.already-member {
  text-align: center;
  padding: 60rpx 0;
}

.member-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.member-text {
  font-size: 30rpx;
  color: #00B42A;
  font-weight: 500;
  display: block;
  margin-bottom: 30rpx;
}

.go-detail-btn {
  width: 280rpx;
  height: 76rpx;
  line-height: 76rpx;
  background: linear-gradient(135deg, #165DFF, #0E42D2);
  color: #fff;
  border-radius: 38rpx;
  font-size: 28rpx;
  border: none;
}

/* 昵称输入 */
.nickname-input {
  letter-spacing: normal;
  text-align: left;
  font-size: 30rpx;
  font-weight: normal;
  padding: 0 24rpx;
}

.next-step-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #165DFF, #0E42D2);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #00B42A, #009A29);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  margin-top: 20rpx;
}

.submit-btn.disabled {
  background: #E5E6EB;
  color: #C9CDD4;
}

/* 操作按钮 */
.action-buttons {
  margin-top: 24rpx;
}

.search-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #fff;
  color: #165DFF;
  border: 2rpx solid #165DFF;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
}
