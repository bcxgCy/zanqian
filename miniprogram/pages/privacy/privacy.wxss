.page {
  padding: var(--spacing);
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: var(--spacing);
  box-shadow: var(--shadow-card);
}

.title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
  margin-bottom: var(--spacing);
}

.content text {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.8;
  margin-bottom: 20rpx;
}
