<view class="page">
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{item.key===currentTab ? 'active' : ''}}"
      data-tab="{{item.key}}"
      bindtap="switchTab"
    >{{item.name}}</view>
  </view>

  <view class="grid">
    <view wx:for="{{filteredBadges}}" wx:key="id" class="item" data-id="{{item.id}}" bindtap="openBadge">
      <image class="badge-image {{item.unlocked ? '' : 'locked'}}" src="{{item.displayImage}}" mode="aspectFill"></image>
      <text class="name">{{item.name}}</text>
    </view>
  </view>

  <view wx:if="{{showBadgeDetail && activeBadge}}" class="mask" bindtap="closeBadgeDetail">
    <view class="modal" catchtap="noop">
      <text class="title">{{activeBadge.name}}</text>
      <view class="modal-image-wrap">
        <image
          class="modal-image"
          src="{{activeBadge.image}}"
          mode="aspectFill"
          bindload="onBadgeImageLoad"
          binderror="onBadgeImageError"
        ></image>
        <view wx:if="{{badgeModalLoading}}" class="modal-image-loading">
          <loading size="24" color="#165DFF"></loading>
          <text class="loading-text">加载中...</text>
        </view>
      </view>
      <text class="desc">{{activeBadge.desc}}</text>
      <text class="time">{{activeBadge.unlockTimeText}}</text>
      <view class="actions">
        <button class="btn-mint" open-type="share" data-id="{{activeBadge.id}}" bindtap="startShareBadge">分享好友</button>
        <button class="btn-ghost" bindtap="closeBadgeDetail">关闭</button>
      </view>
    </view>
  </view>

  <canvas canvas-id="badgePosterCanvas" style="position: fixed; left: -9999px; top: -9999px; width: 750px; height: 1200px;"></canvas>
</view>
