<view class="page">
  <view class="stats-card card">
    <view class="stat-item">
      <text class="stat-value">{{stats.successCount}}</text>
      <text class="stat-label">累计克制</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">¥{{stats.savedTotalText}}</text>
      <text class="stat-label">累计省下</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{stats.extendCountTotal}}</text>
      <text class="stat-label">延长冷静</text>
    </view>
  </view>

  <view class="filter-card card">
    <view class="filter-row">
      <view
        class="filter-chip {{filterStatus === item.key ? 'active' : ''}}"
        wx:for="{{filterTabs}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onFilterChange"
      >{{item.label}}</view>
    </view>
  </view>

  <view class="card list-card" wx:if="{{monthGroups.length}}">
    <view class="month-group" wx:for="{{monthGroups}}" wx:key="monthKey" wx:for-item="group">
      <view class="month-head">
        <text class="month-title">{{group.monthLabel}}</text>
        <text class="month-sub">{{group.items.length}} 条</text>
      </view>
      <view class="history-item" wx:for="{{group.items}}" wx:key="id">
        <view class="history-head">
          <text class="history-name">{{item.goodsName}}</text>
          <text class="history-price">¥{{item.priceText}}</text>
        </view>
        <view class="history-meta">
          <text class="status-tag status-{{item.status}}">{{item.statusText}}</text>
          <text class="history-date">{{item.dateText}}</text>
        </view>
        <text class="history-remark" wx:if="{{item.remark}}">备注：{{item.remark}}</text>
        <text class="history-remark" wx:if="{{item.durationText}}">三思时长：{{item.durationText}}</text>
        <text class="history-extend" wx:if="{{item.extendCount > 0}}">延长三思 {{item.extendCount}} 次</text>
      </view>
    </view>
  </view>

  <view class="card empty-card" wx:elif="{{!loading}}">
    <text class="empty-title">暂无匹配记录</text>
    <text class="empty-desc">可切换筛选查看不同决策结果</text>
  </view>
</view>
