<view class="page">
  <view class="card profile-card">
    <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="avatar avatar-placeholder">👤</view>
    </button>
    <text class="avatar-tip helper-text">点击头像更换</text>
  </view>

  <view class="card">
    <view class="field">
      <text class="label helper-text">昵称</text>
      <input
        class="input"
        type="nickname"
        value="{{nickName}}"
        placeholder="请输入昵称"
        bindblur="onNickNameBlur"
      />
    </view>
  </view>

  <button class="save-btn btn-mint" bindtap="saveProfile">保存</button>
</view>
